<Window x:Class="Occlusa.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="Occlusa — Malaysian Dental Practice Management"
        Width="1600"
        Height="960"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource SurfaceCanvasBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================
             COLUMN 0: PERMANENT LEFT-SIDE NAVIGATION RAIL
             ================================================================ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,22">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="{StaticResource BrandPrimaryBrush}"
                            Margin="0,0,11,0">
                        <Path Data="M 18 8 V 28 M 8 18 H 28"
                              Stroke="{StaticResource TextInverseBrush}"
                              StrokeThickness="3.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="36"
                              Height="36" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OCCLUSA"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SidebarTextPrimaryBrush}" />
                        <TextBlock Text="Malaysian Dental PMS"
                                   FontSize="11"
                                   Foreground="{StaticResource SidebarTextMutedBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Branch Switcher -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="CLINIC BRANCH"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource SidebarSectionLabelBrush}"
                               Margin="4,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableBranches}"
                              SelectedItem="{Binding SelectedBranchId}"
                              Style="{StaticResource UniformSidebarComboBoxStyle}" />
                </StackPanel>

                <!-- Permanent Left-Side Workspace Tabs -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACES"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource SidebarSectionLabelBrush}"
                               Margin="4,0,0,8" />

                    <!-- 1. Live Queue -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsQueueWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="0"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 Z M 12 6 V 12 L 16 14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Live Queue"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueueCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 2. Appointments -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsAppointmentsWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="1"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 5 4 H 19 C 20.1 4 21 4.9 21 6 V 20 C 21 21.1 20.1 22 19 22 H 5 C 3.9 22 3 21.1 3 20 V 6 C 3 4.9 3.9 4 5 4 Z M 16 2 V 6 M 8 2 V 6 M 3 10 H 21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Appointments"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppointmentCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 3. Patients Registry -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsPatientsWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="2"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 17 21 V 19 C 17 16.79 15.21 15 13 15 H 5 C 2.79 15 1 16.79 1 19 V 21 M 9 11 C 11.21 11 13 9.21 13 7 C 13 4.79 11.21 3 9 3 C 6.79 3 5 4.79 5 7 C 5 9.21 6.79 11 9 11 Z M 23 21 V 19 C 23 17.14 21.72 15.57 20 15.13 M 16 3.13 C 17.72 3.57 19 5.14 19 7 C 19 8.86 17.72 10.43 16 10.87"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Patients Registry"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PatientCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 4. Billing & Invoices -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsBillingWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="3"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 4 2 V 22 L 7 20 L 10 22 L 13 20 L 16 22 L 19 20 L 21 22 V 2 L 18 4 L 15 2 L 12 4 L 9 2 L 6 4 Z M 8 9 H 16 M 8 13 H 16 M 8 17 H 13"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Billing &amp; Invoices"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding InvoiceCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 5. WhatsApp AI -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsWhatsAppWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="4"
                                 Style="{StaticResource UniformNavTabRadioStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 21 15 C 21 16.1 20.1 17 19 17 H 7 L 3 21 V 5 C 3 3.9 3.9 3 5 3 H 19 C 20.1 3 21 3.9 21 5 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="WhatsApp AI"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding WhatsAppCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <!-- Urgent Triage & AI Booking Alert Shortcuts -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Button Command="{Binding SelectWorkspaceCommand}"
                            CommandParameter="4"
                            Visibility="{Binding HasEmergencyAlerts, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource UniformSidebarAlertDangerButtonStyle}"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="EMERGENCY ALERT"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextInverseBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="#991B1B"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding EmergencyAlertCount}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextInverseBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding SelectWorkspaceCommand}"
                            CommandParameter="0"
                            Visibility="{Binding HasAiBookedPending, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource UniformSidebarAlertWarningButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="AI-Booked Pending"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextInverseBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="#92400E"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AiBookedPendingCount}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextInverseBrush}" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom-Docked Connection & Sync Panel -->
                <Border Grid.Row="5"
                        Background="{StaticResource SidebarSurfaceBrush}"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F59E0B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSignalRConnected}" Value="True">
                                                <Setter Property="Fill" Value="#22C55E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionModeLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SidebarTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding DatabaseModeLabel, StringFormat='Storage: {0}'}"
                                   FontSize="11"
                                   Foreground="{StaticResource SidebarTextMutedBrush}"
                                   Margin="0,0,0,10" />

                        <Button Content="Sync Workspace"
                                Command="{Binding RefreshSnapshotCommand}"
                                Style="{StaticResource UniformSidebarActionButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================
             COLUMN 1: RIGHT CLINICAL WORKSPACE CANVAS
             ================================================================ -->
        <Grid Grid.Column="1" Margin="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Workspace Title & Quick MyKad Reader Bar -->
            <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}" Padding="16,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveWorkspaceTitle}"
                                   Style="{StaticResource UniformPageTitleTextStyle}"
                                   FontSize="18" />
                        <TextBlock Text="{Binding ActiveWorkspaceSubtitle}"
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MyKad IC:"
                                   Style="{StaticResource UniformLabelTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding SimulatedProfileNames}"
                                  SelectedIndex="{Binding SelectedSimulatedProfileIndex}"
                                  Width="330"
                                  FontSize="12"
                                  Style="{StaticResource UniformComboBoxStyle}"
                                  Margin="0,0,8,0" />
                        <Button Content="Simulate Insert"
                                Command="{Binding SimulateMyKadCommand}"
                                Style="{StaticResource UniformPrimaryButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="Read USB"
                                Command="{Binding ReadPhysicalMyKadCommand}"
                                Style="{StaticResource UniformSecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Pinned Clinical Safety Banner (Hidden on Appointments tab) -->
            <controls:MedicalAlertsBanner Grid.Row="1"
                                          Margin="0,0,0,10"
                                          Visibility="{Binding IsAppointmentsWorkspace, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                          PatientName="{Binding BannerPatientName}"
                                          IcNumber="{Binding BannerIcNumber}"
                                          IsMyKadVerified="{Binding BannerIsMyKadVerified}"
                                          Allergies="{Binding BannerAllergies}"
                                          OnAnticoagulants="{Binding BannerOnAnticoagulants}"
                                          HasDiabetes="{Binding BannerHasDiabetes}"
                                          IsPregnant="{Binding BannerIsPregnant}"
                                          AlertNotes="{Binding BannerAlertNotes}" />

            <!-- Row 2: Contextual Workspace Action Toolbar (Exact 32px Baseline Alignment) -->
            <Border Grid.Row="2" Style="{StaticResource UniformCardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <!-- 1. Queue Tab Actions -->
                    <DockPanel Visibility="{Binding IsQueueWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Approve AI-Booked"
                                    Command="{Binding ApproveSelectedAiBookingCommand}"
                                    Style="{StaticResource UniformWarningButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,10,0" />

                            <Border Width="1"
                                    Height="20"
                                    Background="{StaticResource BorderHairlineBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0" />

                            <TextBlock Text="Status:"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button Content="Arrived"
                                    Command="{Binding AdvanceQueueStatusCommand}"
                                    CommandParameter="Arrived"
                                    Style="{StaticResource UniformSegmentButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Content="Waiting"
                                    Command="{Binding AdvanceQueueStatusCommand}"
                                    CommandParameter="Waiting"
                                    Style="{StaticResource UniformSegmentButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Content="In Chair"
                                    Command="{Binding AdvanceQueueStatusCommand}"
                                    CommandParameter="InChair"
                                    Style="{StaticResource UniformSegmentButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Content="Awaiting Checkout"
                                    Command="{Binding AdvanceQueueStatusCommand}"
                                    CommandParameter="AwaitingCheckout"
                                    Style="{StaticResource UniformSegmentButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Content="Completed"
                                    Command="{Binding AdvanceQueueStatusCommand}"
                                    CommandParameter="Completed"
                                    Style="{StaticResource UniformSegmentButtonStyle}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Patient Chart"
                                    Click="OpenSelectedQueuePatientButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="32-Tooth Odontogram"
                                    Click="OpenSelectedQueueOdontogramButton_Click"
                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 2. Appointments Tab Actions -->
                    <Grid Visibility="{Binding IsAppointmentsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding Appointments}">
                            <!-- Row A: Display Mode, Date Navigation, Range Switcher, Day Slot Zoom, New Appt -->
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton GroupName="ApptDisplayMode"
                                                 Content="Calendar"
                                                 IsChecked="{Binding IsCalendarMode, Mode=OneWay}"
                                                 Command="{Binding SetDisplayModeCommand}"
                                                 CommandParameter="Calendar"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptDisplayMode"
                                                 Content="Table"
                                                 IsChecked="{Binding IsTableMode, Mode=OneWay}"
                                                 Command="{Binding SetDisplayModeCommand}"
                                                 CommandParameter="Table"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,10,0" />

                                    <Border Width="1"
                                            Height="20"
                                            Background="{StaticResource BorderHairlineBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />

                                    <Button Content="◀"
                                            Command="{Binding PrevRangeCommand}"
                                            Style="{StaticResource UniformSegmentButtonStyle}"
                                            Width="32"
                                            Padding="0"
                                            Margin="0,0,4,0" />
                                    <Button Content="Today"
                                            Command="{Binding TodayCommand}"
                                            Style="{StaticResource UniformSegmentButtonStyle}"
                                            Margin="0,0,4,0" />
                                    <Button Content="▶"
                                            Command="{Binding NextRangeCommand}"
                                            Style="{StaticResource UniformSegmentButtonStyle}"
                                            Width="32"
                                            Padding="0"
                                            Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding ActiveRangeTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />

                                    <Border Width="1"
                                            Height="20"
                                            Background="{StaticResource BorderHairlineBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />

                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="Day"
                                                 IsChecked="{Binding IsRangeDayChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="Day"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="Week"
                                                 IsChecked="{Binding IsRangeWeekChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="Week"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="Month"
                                                 IsChecked="{Binding IsRangeMonthChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="Month"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="All"
                                                 Visibility="{Binding IsTableMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 IsChecked="{Binding IsRangeAllChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="All"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsDayCalendarView, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="6,0,0,0">
                                        <Border Width="1"
                                                Height="20"
                                                Background="{StaticResource BorderHairlineBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0" />
                                        <RadioButton GroupName="ApptDaySession"
                                                     Content="Full Day"
                                                     IsChecked="{Binding IsFullDaySession, Mode=OneWay}"
                                                     Command="{Binding SetDaySessionCommand}"
                                                     CommandParameter="FullDay"
                                                     Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                     Margin="0,0,4,0" />
                                        <RadioButton GroupName="ApptDaySession"
                                                     Content="AM"
                                                     IsChecked="{Binding IsMorningSession, Mode=OneWay}"
                                                     Command="{Binding SetDaySessionCommand}"
                                                     CommandParameter="Morning"
                                                     Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                     Margin="0,0,4,0" />
                                        <RadioButton GroupName="ApptDaySession"
                                                     Content="PM"
                                                     IsChecked="{Binding IsAfternoonSession, Mode=OneWay}"
                                                     Command="{Binding SetDaySessionCommand}"
                                                     CommandParameter="Afternoon"
                                                     Style="{StaticResource UniformSegmentedToggleRadioStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Content="+ New Appointment"
                                        Click="NewAppointmentButton_Click"
                                        Style="{StaticResource UniformPrimaryButtonStyle}"
                                        Height="32"
                                        Padding="12,0"
                                        FontSize="12" />
                            </DockPanel>

                            <!-- Row B: Step 1 (Treatment) -> Step 2 (Qualified Dentist) -> Patient Filters -->
                            <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Treatment:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding TreatmentFilterOptions}"
                                              SelectedItem="{Binding SelectedTreatmentFilter, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Width="205"
                                              Height="32"
                                              FontSize="12"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,12,0" />

                                    <TextBlock Text="Dentist:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding DentistFilterOptions}"
                                              SelectedItem="{Binding SelectedDentistFilter, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Width="195"
                                              Height="32"
                                              FontSize="12"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,12,0" />

                                    <TextBlock Text="Patient:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Text="{Binding PatientFilterText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="190"
                                             Height="32"
                                             Style="{StaticResource UniformInputTextBoxStyle}"
                                             Margin="0,0,6,0" />

                                    <Button Content="Clear"
                                            Command="{Binding ClearFiltersCommand}"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource UniformGhostButtonStyle}"
                                            Height="32" />
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FilteredSummaryLabel}"
                                           Style="{StaticResource UniformMutedTextStyle}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Patients Tab Actions -->
                    <DockPanel Visibility="{Binding IsPatientsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter Patients:"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding PatientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"
                                     Height="32"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,6,0" />
                            <Button Content="Clear"
                                    Command="{Binding ClearPatientSearchCommand}"
                                    Visibility="{Binding PatientSearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                    Style="{StaticResource UniformGhostButtonStyle}"
                                    Height="32" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Register &amp; Book"
                                    Click="RegisterPatientAndBookButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="Check-In to Queue"
                                    Command="{Binding CheckInSelectedPatientCommand}"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="Open Patient Chart"
                                    Click="OpenSelectedPatientButton_Click"
                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 3. Billing Tab Actions -->
                    <DockPanel Visibility="{Binding IsBillingWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Double-click an invoice to split-pay (Panel + Cash + Card + QR) or soft-void with audit trail."
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open Invoice Checkout"
                                    Click="OpenSelectedInvoiceButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="End-of-Day Reconciliation"
                                    Click="OpenDailyReconciliationButton_Click"
                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 4. WhatsApp Tab Actions -->
                    <DockPanel Visibility="{Binding IsWhatsAppWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="AI bookings default to AiBookedPending. Emergency red flags immediately halt booking and escalate."
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="Open WhatsApp Simulator &amp; Staff Takeover"
                                Click="OpenWhatsAppConsoleButton_Click"
                                Style="{StaticResource UniformPrimaryButtonStyle}"
                                Height="32"
                                Padding="14,0"
                                FontSize="12" />
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Row 3: 4 Uniform 4-Column Paged Tables (Auto 11 rows @ 1080p, 17 rows @ 1440p) -->
            <Grid Grid.Row="3">
                <!-- 1. Live Queue & Schedule -->
                <controls:UniformPagedGrid x:Name="QueuePagedGrid"
                                           Visibility="{Binding IsQueueWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Title="Live Queue &amp; Chair Schedule"
                                           Subtitle="Double-click any row to open Patient Chart or Odontogram"
                                           EmptyMessage="No queued appointments for this branch yet."
                                           ItemsSource="{Binding QueueRows}"
                                           SelectedItem="{Binding SelectedQueueRow, Mode=TwoWay}"
                                           RowDoubleClicked="QueuePagedGrid_RowDoubleClicked">
                    <controls:UniformColumnDef Header="Time" BindingPath="TimeDisplay" WidthRatio="0.7" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Patient" BindingPath="PatientDisplay" WidthRatio="2.1" IsBold="True" />
                    <controls:UniformColumnDef Header="Doctor &amp; Room" BindingPath="DoctorRoomDisplay" WidthRatio="1.7" />
                    <controls:UniformColumnDef Header="Status" BindingPath="StatusDisplay" WidthRatio="1.3" />
                </controls:UniformPagedGrid>

                <!-- 2. Appointments (Calendar + Paged Table) -->
                <Grid Visibility="{Binding IsAppointmentsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:AppointmentsWorkspaceView x:Name="AppointmentsWorkspace"
                                                        DataContext="{Binding Appointments}" />
                </Grid>

                <!-- 3. Patients Registry -->
                <controls:UniformPagedGrid x:Name="PatientsPagedGrid"
                                           Visibility="{Binding IsPatientsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Title="Malaysian Patients Registry"
                                           Subtitle="Double-click any patient for Clinical Record, SOAP Notes &amp; Odontogram"
                                           EmptyMessage="No matching patients found."
                                           ItemsSource="{Binding PatientRows}"
                                           SelectedItem="{Binding SelectedPatientRow, Mode=TwoWay}"
                                           RowDoubleClicked="PatientsPagedGrid_RowDoubleClicked">
                    <controls:UniformColumnDef Header="IC / MyKad" BindingPath="IcDisplay" WidthRatio="1.2" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Full Name" BindingPath="FullName" WidthRatio="2.1" IsBold="True" />
                    <controls:UniformColumnDef Header="Phone" BindingPath="Phone" WidthRatio="1.1" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Alerts" BindingPath="AlertsDisplay" WidthRatio="1.8" />
                </controls:UniformPagedGrid>

                <!-- 3. Billing & Invoices -->
                <controls:UniformPagedGrid x:Name="InvoicesPagedGrid"
                                           Visibility="{Binding IsBillingWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Title="Reception Billing &amp; Invoices"
                                           Subtitle="Double-click any invoice for Split-Payment Checkout &amp; Soft-Void"
                                           EmptyMessage="No invoices recorded for this branch yet."
                                           ItemsSource="{Binding InvoiceRows}"
                                           SelectedItem="{Binding SelectedInvoiceRow, Mode=TwoWay}"
                                           RowDoubleClicked="InvoicesPagedGrid_RowDoubleClicked">
                    <controls:UniformColumnDef Header="Invoice #" BindingPath="InvoiceNumber" WidthRatio="1.3" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Patient" BindingPath="PatientName" WidthRatio="2.1" IsBold="True" />
                    <controls:UniformColumnDef Header="Payable (RM)" BindingPath="PayableDisplay" WidthRatio="1.1" IsMonospace="True" HorizontalAlignment="Right" />
                    <controls:UniformColumnDef Header="Status" BindingPath="StatusDisplay" WidthRatio="1.3" />
                </controls:UniformPagedGrid>

                <!-- 4. WhatsApp AI Console -->
                <controls:UniformPagedGrid x:Name="WhatsAppPagedGrid"
                                           Visibility="{Binding IsWhatsAppWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Title="WhatsApp AI Receptionist Threads"
                                           Subtitle="Double-click any thread for Paged Transcript, Simulator &amp; Emergency Takeover"
                                           EmptyMessage="No WhatsApp conversations yet — open Simulator to test AI triage."
                                           ItemsSource="{Binding WhatsAppRows}"
                                           SelectedItem="{Binding SelectedWhatsAppRow, Mode=TwoWay}"
                                           RowDoubleClicked="WhatsAppPagedGrid_RowDoubleClicked">
                    <controls:UniformColumnDef Header="Phone / Patient" BindingPath="ContactDisplay" WidthRatio="2.1" IsBold="True" />
                    <controls:UniformColumnDef Header="Last Update" BindingPath="LastUpdatedDisplay" WidthRatio="1.2" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Triage" BindingPath="TriageDisplay" WidthRatio="1.1" />
                    <controls:UniformColumnDef Header="State" BindingPath="StateDisplay" WidthRatio="1.2" />
                </controls:UniformPagedGrid>
            </Grid>

            <!-- Row 4: Clean Status Footer Strip -->
            <Border Grid.Row="4"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,7"
                    Margin="0,10,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{Binding MyKadReaderStatus}"
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  ·  Double-click any row to open details"
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource UniformMutedTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
