                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerPressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#FCA5A5" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FCA5A5" />
                            <Setter Property="Cursor" Value="Arrow" />
