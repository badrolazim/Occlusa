<Window x:Class="Occlusa.Desktop.Views.InvoiceCheckoutModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="Invoice Checkout &amp; Split Payment"
        Width="1160"
        Height="780"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceCanvasBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <controls:ModalDialogShell Title="{Binding ModalTitle}"
                               Subtitle="{Binding ModalSubtitle}"
                               BadgeText="{Binding StatusBadgeText}"
                               HasUnsavedChanges="{Binding HasUnsavedChanges, Mode=TwoWay}"
                               SaveCommand="{Binding SettlePaymentCommand}"
                               UnsavedPromptTitle="Unsaved Billing Edits"
                               UnsavedPromptMessage="You have unsubmitted payment or void changes. Apply payment before closing?">

        <controls:ModalDialogShell.DialogContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Paged Line Items & Live Commission / Balance Summary -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:UniformPagedGrid Grid.Row="0"
                                               Title="Itemized Procedures"
                                               Subtitle="4 Columns · Paged (No Scrollbars)"
                                               EmptyMessage="No billed procedures on this invoice yet."
                                               ItemsSource="{Binding LineRows}"
                                               AutoPageSize="False"
                                               PageSize="5">
                        <controls:UniformColumnDef Header="Tooth" BindingPath="ToothDisplay" WidthRatio="0.8" IsMonospace="True" />
                        <controls:UniformColumnDef Header="Procedure" BindingPath="ProcedureName" WidthRatio="2.2" IsBold="True" />
                        <controls:UniformColumnDef Header="Qty" BindingPath="Quantity" WidthRatio="0.6" HorizontalAlignment="Center" />
                        <controls:UniformColumnDef Header="Total (RM)" BindingPath="LineTotalDisplay" WidthRatio="1.1" IsMonospace="True" HorizontalAlignment="Right" />
                    </controls:UniformPagedGrid>

                    <!-- Symmetric KPI Financial Summary Card -->
                    <Border Grid.Row="2" Style="{StaticResource UniformCardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource UniformSubtleCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Invoice Subtotal" Style="{StaticResource UniformLabelTextStyle}" />
                                        <TextBlock Text="{Binding Invoice.Subtotal, StringFormat='RM {0:N2}'}"
                                                   Style="{StaticResource UniformSectionTitleTextStyle}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource UniformSubtleCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Patient Payable (After Panel)" Style="{StaticResource UniformLabelTextStyle}" />
                                        <TextBlock Text="{Binding ProjectedPayable, StringFormat='RM {0:N2}'}"
                                                   Style="{StaticResource UniformSectionTitleTextStyle}"
                                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource UniformSubtleCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Already Paid" Style="{StaticResource UniformLabelTextStyle}" />
                                        <TextBlock Text="{Binding Invoice.PaidAmount, StringFormat='RM {0:N2}'}"
                                                   Style="{StaticResource UniformSectionTitleTextStyle}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource UniformSubtleCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Projected Balance Due" Style="{StaticResource UniformLabelTextStyle}" />
                                        <TextBlock Text="{Binding ProjectedBalanceDue, StringFormat='RM {0:N2}'}"
                                                   Style="{StaticResource UniformSectionTitleTextStyle}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource BrandSecondarySoftBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Estimated Doctor Commission (40% Net)"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Foreground="{StaticResource BrandSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ProjectedCommission, StringFormat='RM {0:N2}'}"
                                               Style="{StaticResource UniformSectionTitleTextStyle}"
                                               Foreground="{StaticResource BrandSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Corporate Panel, Split-Payments, Soft-Void -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Settlement Card -->
                    <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}">
                        <StackPanel IsEnabled="{Binding IsEditable}">
                            <TextBlock Text="Corporate Panel &amp; Split-Payment Settlement"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Corporate Panel" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailablePanels}"
                                              SelectedItem="{Binding SelectedPanel}"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Panel Cover (RM)" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PanelCoverageInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Discount (RM)" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cash (RM)" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding CashInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Card (RM)" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding CardInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="QR / Transfer (RM)" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QrInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Payment / Terminal Reference #" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ReferenceNoInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,0,12" />

                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Full Cash"
                                            Command="{Binding FillRemainingInCashCommand}"
                                            Style="{StaticResource UniformSecondaryButtonStyle}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Full QR"
                                            Command="{Binding FillRemainingInQrCommand}"
                                            Style="{StaticResource UniformSecondaryButtonStyle}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Settle Payment"
                                        Command="{Binding SettlePaymentCommand}"
                                        Style="{StaticResource UniformPrimaryButtonStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audited Soft-Void Card -->
                    <Border Grid.Row="2" Style="{StaticResource UniformCardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Immutable Audit &amp; Soft-Void Control"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1"
                                       Text="Financial records are never hard-deleted. Soft-voiding requires a mandatory reason logged to Audit Trail."
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2"
                                       Text="Mandatory Void Reason"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       Margin="0,0,0,4" />
                            <TextBox Grid.Row="3"
                                     Text="{Binding VoidReasonInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,0,12" />

                            <DockPanel Grid.Row="4" VerticalAlignment="Bottom" LastChildFill="False">
                                <Button DockPanel.Dock="Right"
                                        Content="Soft-Void Invoice"
                                        Command="{Binding SoftVoidInvoiceCommand}"
                                        Style="{StaticResource UniformDangerButtonStyle}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </controls:ModalDialogShell.DialogContent>

        <controls:ModalDialogShell.FooterLeftContent>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource UniformBodyTextStyle}"
                       Foreground="{StaticResource BrandPrimaryBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </controls:ModalDialogShell.FooterLeftContent>
    </controls:ModalDialogShell>
</Window>
