<Window x:Class="Occlusa.Desktop.Views.UserPreferencesModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="My View Settings"
        Width="660"
        Height="560"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <controls:ModalDialogShell x:Name="DialogShell"
                               Title="{Binding ModalTitle}"
                               Subtitle="{Binding ModalSubtitle}"
                               BadgeText="{Binding ActivePresetBadge}"
                               HasUnsavedChanges="{Binding HasUnsavedChanges, Mode=TwoWay}"
                               SaveCommand="{Binding SavePreferencesCommand}"
                               UnsavedPromptTitle="Unsaved View Settings"
                               UnsavedPromptMessage="Save your Live Queue view preferences before closing?">

        <controls:ModalDialogShell.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. One-Click View Presets -->
                <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1. Choose Your Live Queue Mode"
                                   Style="{StaticResource UniformSectionTitleTextStyle}"
                                   FontSize="13.5"
                                   Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Simple View Card -->
                            <Button Grid.Column="0"
                                    Command="{Binding SelectPresetCommand}"
                                    CommandParameter="Simple"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" BorderThickness="1.5" Padding="12,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSimplePreset}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrandPrimarySoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="Simple View"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Border DockPanel.Dock="Right"
                                                            Background="{StaticResource BrandTintBrush}"
                                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="7,1">
                                                        <TextBlock Text="Default"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrandHoverBrush}" />
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="Calm 3-Column Kanban Board (Waiting · In Chair · Ready for Payment) with collapsible Scheduled &amp; Completed drawers and 1-click next-process card buttons."
                                                           Style="{StaticResource UniformMutedTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Detailed View Card -->
                            <Button Grid.Column="2"
                                    Command="{Binding SelectPresetCommand}"
                                    CommandParameter="Detailed"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" BorderThickness="1.5" Padding="12,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDetailedPreset}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrandPrimarySoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="Detailed Operations View"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Margin="0,0,0,4" />
                                                <TextBlock Text="Same 3-Column Kanban Board enriched with live wait &amp; chair timers, arrival &amp; IC telemetry, inline reception notes, and extra toolbar controls."
                                                           Style="{StaticResource UniformMutedTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Fine-Tuning Toggles -->
                <Border Grid.Row="1" Style="{StaticResource UniformCardBorderStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="2. Fine-Tune Your Workspace"
                                   Style="{StaticResource UniformSectionTitleTextStyle}"
                                   FontSize="13.5"
                                   Margin="0,0,0,10" />

                        <!-- Default Queue Scope -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Default Patient Queue Scope"
                                           Style="{StaticResource UniformLabelTextStyle}" />
                                <TextBlock Text="{Binding ScopeHintText}"
                                           Style="{StaticResource UniformMutedTextStyle}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton GroupName="PrefDefaultScope"
                                             Content="My Queue"
                                             IsChecked="{Binding IsMyQueueScopeDefault, Mode=OneWay}"
                                             Command="{Binding SelectDefaultScopeCommand}"
                                             CommandParameter="MyQueue"
                                             IsEnabled="{Binding IsDentist}"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                             Margin="0,0,5,0" />
                                <RadioButton GroupName="PrefDefaultScope"
                                             Content="All Clinic"
                                             IsChecked="{Binding IsAllClinicScopeDefault, Mode=OneWay}"
                                             Command="{Binding SelectDefaultScopeCommand}"
                                             CommandParameter="AllClinic"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,0,10" />

                        <CheckBox Content="Hide Completed &amp; Cancelled visits by default (keep queue focused on active patients)"
                                  IsChecked="{Binding HideFinishedQueueRows, Mode=TwoWay}"
                                  Style="{StaticResource UniformCheckBoxStyle}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Show live wait &amp; chair timers inside status pills (e.g., Waiting · 28m, red alert at 30m+)"
                                  IsChecked="{Binding ShowWaitTimers, Mode=TwoWay}"
                                  Style="{StaticResource UniformCheckBoxStyle}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Show reception notes inside Detailed Live Queue Kanban cards"
                                  IsChecked="{Binding ShowInlineReceptionNotes, Mode=TwoWay}"
                                  Style="{StaticResource UniformCheckBoxStyle}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Show full MyKad IC reader &amp; simulator bar in the top workspace header"
                                  IsChecked="{Binding ShowMyKadQuickBar, Mode=TwoWay}"
                                  Style="{StaticResource UniformCheckBoxStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:ModalDialogShell.DialogContent>

        <controls:ModalDialogShell.FooterLeftContent>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource UniformBodyTextStyle}">
                        <Setter Property="Foreground" Value="{StaticResource BrandHoverBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </controls:ModalDialogShell.FooterLeftContent>

        <controls:ModalDialogShell.FooterContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Reset to Default"
                        Command="{Binding ResetToRoleDefaultCommand}"
                        Style="{StaticResource UniformGhostButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Save Preferences"
                        Command="{Binding SavePreferencesCommand}"
                        Style="{StaticResource UniformPrimaryButtonStyle}" />
            </StackPanel>
        </controls:ModalDialogShell.FooterContent>
    </controls:ModalDialogShell>
</Window>

