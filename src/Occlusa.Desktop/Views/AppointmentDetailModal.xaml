<Window x:Class="Occlusa.Desktop.Views.AppointmentDetailModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="Appointment Details &amp; Booking"
        Width="1060"
        Height="810"
        MinWidth="980"
        MinHeight="770"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceCanvasBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <controls:ModalDialogShell x:Name="DialogShell"
                               Title="{Binding ModalTitle}"
                               Subtitle="{Binding ModalSubtitle}"
                               BadgeText="{Binding BadgeLabel}"
                               HasUnsavedChanges="{Binding HasUnsavedChanges, Mode=TwoWay}"
                               SaveCommand="{Binding SaveAppointmentCommand}"
                               UnsavedPromptTitle="Unsaved Appointment Changes"
                               UnsavedPromptMessage="You have unsaved appointment edits. Save changes before closing?">

        <controls:ModalDialogShell.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Pinned Clinical Safety Banner (Shown only once a patient is selected/entered) -->
                <controls:MedicalAlertsBanner Grid.Row="0"
                                              Margin="0,0,0,10"
                                              Visibility="{Binding ShowPatientSafetyBanner, Converter={StaticResource BoolToVisibilityConverter}}"
                                              PatientName="{Binding BannerPatientName}"
                                              IcNumber="{Binding BannerIcNumber}"
                                              IsMyKadVerified="{Binding BannerIsMyKadVerified}"
                                              Allergies="{Binding BannerAllergies}"
                                              OnAnticoagulants="{Binding BannerOnAnticoagulants}"
                                              HasDiabetes="{Binding BannerHasDiabetes}"
                                              IsPregnant="{Binding BannerIsPregnant}"
                                              AlertNotes="{Binding BannerAlertNotes}" />

                <!-- Two-Column 4-Step Booking Workspace (Zero Scrollbars) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Step 1 (Treatment -> Qualified Dentist) & Step 2 (Date & Availability) -->
                    <Border Grid.Column="0" Style="{StaticResource UniformCardBorderStyle}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="1. Treatment &amp; Qualified Dentist"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Treatment *"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Treatments}"
                                      SelectedItem="{Binding SelectedTreatment, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource UniformComboBoxStyle}"
                                      Margin="0,0,0,3" />
                            <TextBlock Text="{Binding TreatmentFeeSummary}"
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Qualified Dentist *"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding EligibleDentists}"
                                              SelectedItem="{Binding SelectedDentist, Mode=TwoWay}"
                                              DisplayMemberPath="FullName"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Room / Suite"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableRooms}"
                                              SelectedItem="{Binding RoomName, Mode=TwoWay}"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DentistQualificationHint}"
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="Schedule Procedure Label"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       Margin="0,0,0,3" />
                            <TextBox Text="{Binding CustomProcedureText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,0,10" />

                            <Border Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="2. Date &amp; Dentist Availability"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0"
                                            SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                            Height="32"
                                            FontFamily="{StaticResource FontFamilyPrimary}"
                                            FontSize="12.5"
                                            VerticalContentAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Today"
                                            Command="{Binding SetDateOffsetCommand}"
                                            CommandParameter="0"
                                            Style="{StaticResource UniformChipButtonStyle}"
                                            Margin="0,0,5,0" />
                                    <Button Content="+1 Day"
                                            Command="{Binding SetDateOffsetCommand}"
                                            CommandParameter="1"
                                            Style="{StaticResource UniformChipButtonStyle}"
                                            Margin="0,0,5,0" />
                                    <Button Content="+1 Week"
                                            Command="{Binding SetDateOffsetCommand}"
                                            CommandParameter="7"
                                            Style="{StaticResource UniformChipButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding AvailabilitySummary}"
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />

                            <!-- 3x3 Hourly Availability Grid (Zero Scrollbars) -->
                            <ItemsControl ItemsSource="{Binding DentistAvailabilitySlots}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Rows="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectAvailabilitySlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Summary}"
                                                Height="32"
                                                Margin="0,0,4,4"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                            CornerRadius="5"
                                                            BorderThickness="1"
                                                            Padding="8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource BrandPrimarySoftBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryPressedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Label}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding StatusLabel}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start Hour"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableHours}"
                                              SelectedItem="{Binding SelectedHour, Mode=TwoWay}"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Minute"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableMinutes}"
                                              SelectedItem="{Binding SelectedMinute, Mode=TwoWay}"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Duration (min)"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableDurations}"
                                              SelectedItem="{Binding DurationMinutes, Mode=TwoWay}"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT COLUMN: Step 3 & 4 (Patient IC/Name/Phone Lookup + Register Prompt + Notes + Staff Activity Trail) -->
                    <Border Grid.Column="2" Style="{StaticResource UniformCardBorderStyle}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="3. Patient Lookup (IC, Name, or Phone)"
                                           Style="{StaticResource UniformSectionTitleTextStyle}"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Content="+ New Patient"
                                        Command="{Binding StartRegisterNewPatientCommand}"
                                        Visibility="{Binding CanShowQuickRegisterButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource UniformGhostButtonStyle}"
                                        Height="26"
                                        FontSize="11.5" />
                                <Button DockPanel.Dock="Right"
                                        Content="&#x2190; Back to Search"
                                        Command="{Binding BackToPatientSearchCommand}"
                                        Visibility="{Binding CanShowBackToSearchButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource UniformGhostButtonStyle}"
                                        Height="26"
                                        FontSize="11.5" />
                            </DockPanel>

                            <!-- Patient States (Lookup / Confirmed Card / Register New) -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <!-- State A: Search & Auto-Suggest -->
                                <StackPanel Visibility="{Binding ShowPatientLookupPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Enter Patient IC, Name, or Phone *"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Margin="0,0,0,3" />
                                    <TextBox Text="{Binding PatientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}"
                                             Margin="0,0,0,6" />

                                    <Border Style="{StaticResource UniformSubtleCardBorderStyle}"
                                            Visibility="{Binding ShowLookupHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Start typing patient IC (with or without dashes), full name, or phone to see matching patients."
                                                   Style="{StaticResource UniformMutedTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Auto-Suggested Matches (Max 4 rows, Zero Scrollbars) -->
                                    <ItemsControl ItemsSource="{Binding SuggestedPatients}"
                                                  Visibility="{Binding HasPatientSuggestions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectSuggestedPatientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource UniformCalendarEventButtonStyle}"
                                                        Padding="10,6"
                                                        Margin="0,0,0,4">
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FullName}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <TextBlock Style="{StaticResource UniformMutedTextStyle}" Margin="0,1,0,0">
                                                                <Run Text="{Binding IcNumber, Mode=OneWay}" FontFamily="Consolas" />
                                                                <Run Text="  &#x00B7;  " />
                                                                <Run Text="{Binding Phone, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="Select &#x2192;"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- No Match Found -> Prompt to Add Patient -->
                                    <Border Visibility="{Binding ShowNoPatientMatchPrompt, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{StaticResource WarningBgBrush}"
                                            BorderBrush="{StaticResource WarningBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Content="+ Register New Patient"
                                                    Command="{Binding StartRegisterNewPatientCommand}"
                                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                                    Height="32"
                                                    Margin="10,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NoPatientMatchText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="Would you like to register this patient now?"
                                                           Style="{StaticResource UniformMutedTextStyle}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- State B: Confirmed Existing Patient Card -->
                                <Border Visibility="{Binding ShowConfirmedPatientCard, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{StaticResource BrandPrimarySoftBrush}"
                                        BorderBrush="{StaticResource BrandPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="Change"
                                                Command="{Binding ChangeSelectedPatientCommand}"
                                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                Style="{StaticResource UniformCompactSecondaryButtonStyle}"
                                                Margin="10,0,0,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedPatient.FullName}"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource UniformMutedTextStyle}" Margin="0,2,0,0">
                                                <Run Text="{Binding SelectedPatient.IcNumber, Mode=OneWay}" FontFamily="Consolas" />
                                                <Run Text="  &#x00B7;  " />
                                                <Run Text="{Binding SelectedPatient.Phone, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- State C: Inline Register New Patient -->
                                <StackPanel Visibility="{Binding IsRegisterNewPatientMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Full Name *"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               Margin="0,0,0,3" />
                                    <TextBox Text="{Binding NewPatientFullName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}"
                                             Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="IC / Passport # *"
                                                       Style="{StaticResource UniformLabelTextStyle}"
                                                       Margin="0,0,0,3" />
                                            <TextBox Text="{Binding NewPatientIcNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource UniformInputTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phone"
                                                       Style="{StaticResource UniformLabelTextStyle}"
                                                       Margin="0,0,0,3" />
                                            <TextBox Text="{Binding NewPatientPhone, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource UniformInputTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding NricParseHint}"
                                               Style="{StaticResource UniformMutedTextStyle}"
                                               Foreground="{StaticResource BrandPrimaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.85*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="1.25*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Gender"
                                                       Style="{StaticResource UniformLabelTextStyle}"
                                                       Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding AvailableGenders}"
                                                      SelectedItem="{Binding NewPatientGender, Mode=TwoWay}"
                                                      Style="{StaticResource UniformComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Allergies (Optional)"
                                                       Style="{StaticResource UniformLabelTextStyle}"
                                                       Margin="0,0,0,3" />
                                            <TextBox Text="{Binding NewPatientAllergies, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource UniformInputTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  Content="Anticoagulants"
                                                  IsChecked="{Binding NewPatientOnAnticoagulants}"
                                                  Style="{StaticResource UniformCheckBoxStyle}" />
                                        <CheckBox Grid.Column="1"
                                                  Content="Diabetes"
                                                  IsChecked="{Binding NewPatientHasDiabetes}"
                                                  Style="{StaticResource UniformCheckBoxStyle}" />
                                        <CheckBox Grid.Column="2"
                                                  Content="Pregnant"
                                                  IsChecked="{Binding NewPatientIsPregnant}"
                                                  Style="{StaticResource UniformCheckBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Appointment Status -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <TextBlock Text="Appointment Status"
                                           Style="{StaticResource UniformLabelTextStyle}"
                                           Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                          SelectedItem="{Binding Status, Mode=TwoWay}"
                                          Style="{StaticResource UniformComboBoxStyle}" />
                            </StackPanel>

                            <!-- Reception Note -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,3">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Reception Note"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="Shown under patient name in Live Queue"
                                               Style="{StaticResource UniformMutedTextStyle}"
                                               FontSize="10.5"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Grid.Row="1"
                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                         MinHeight="56" />
                            </Grid>

                            <!-- Staff Attribution / Visit Activity Trail (Edit mode only, paged, zero scrollbars) -->
                            <Border Grid.Row="4"
                                    Visibility="{Binding HasActivityLog, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource UniformSubtleCardBorderStyle}"
                                    Padding="10,8"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="Staff Activity Trail (Who Did What)"
                                                   Style="{StaticResource UniformLabelTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ShowActivityPaging, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button Content="◀"
                                                    Command="{Binding PrevActivityPageCommand}"
                                                    IsEnabled="{Binding CanActivityPrev}"
                                                    Style="{StaticResource UniformGhostButtonStyle}"
                                                    Height="22"
                                                    Width="24"
                                                    Padding="0"
                                                    FontSize="10.5" />
                                            <TextBlock Text="{Binding ActivityPageSummary}"
                                                       Style="{StaticResource UniformMutedTextStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0" />
                                            <Button Content="▶"
                                                    Command="{Binding NextActivityPageCommand}"
                                                    IsEnabled="{Binding CanActivityNext}"
                                                    Style="{StaticResource UniformGhostButtonStyle}"
                                                    Height="22"
                                                    Width="24"
                                                    Padding="0"
                                                    FontSize="10.5" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding PagedActivityEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True"
                                                           Margin="0,1"
                                                           ToolTip="{Binding ToolTipText}"
                                                           Background="Transparent">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="{Binding TimestampDisplay}"
                                                               FontFamily="{StaticResource FontFamilyMono}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrandPrimaryBrush}"
                                                               Width="42"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SummaryLine}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="None" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </controls:ModalDialogShell.DialogContent>

        <controls:ModalDialogShell.FooterLeftContent>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource UniformBodyTextStyle}">
                        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </controls:ModalDialogShell.FooterLeftContent>

        <controls:ModalDialogShell.FooterContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Patient Chart"
                        Click="OpenPatientChartButton_Click"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource UniformSecondaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Odontogram"
                        Click="OpenOdontogramButton_Click"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource UniformSecondaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Approve AI-Booked"
                        Command="{Binding ApproveAiBookingCommand}"
                        Visibility="{Binding CanApproveAiBooking, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource UniformWarningButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Cancel Appt"
                        Command="{Binding CancelAppointmentCommand}"
                        Visibility="{Binding CanCancelAppointment, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource UniformDangerButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="{Binding SaveButtonText}"
                        Command="{Binding SaveAppointmentCommand}"
                        Style="{StaticResource UniformPrimaryButtonStyle}" />
            </StackPanel>
        </controls:ModalDialogShell.FooterContent>
    </controls:ModalDialogShell>
</Window>
