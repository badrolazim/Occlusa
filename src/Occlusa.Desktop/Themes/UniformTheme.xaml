<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         OCCLUSA CALM DENTAL APP COLOR SYSTEM (60-30-10 + SEMANTIC TOKENS)
         Zero Scrollbars | Zero Text Truncation | 1080p & 1440p Ready
         ================================================================ -->

    <!-- Canonical Core Palette (60-30-10) -->
    <Color x:Key="BgCanvasColor">#F7FAFA</Color>
    <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BgSubtleColor">#EDF3F3</Color>
    <Color x:Key="BorderDefaultColor">#D8E3E3</Color>
    <Color x:Key="TextPrimaryColor">#182929</Color>
    <Color x:Key="TextSecondaryColor">#566B6B</Color>
    <Color x:Key="BrandPrimaryColor">#069494</Color>
    <Color x:Key="BrandHoverColor">#057878</Color>
    <Color x:Key="BrandTintColor">#E3F4F4</Color>

    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgSubtleBrush" Color="{StaticResource BgSubtleColor}" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandTintBrush" Color="{StaticResource BrandTintColor}" />

    <!-- Canonical Semantic Palette (Calm State & Feedback) -->
    <Color x:Key="StatusSuccessColor">#2B825B</Color>
    <Color x:Key="StatusSuccessBgColor">#EAF6F0</Color>
    <Color x:Key="StatusInfoColor">#2E6FA3</Color>
    <Color x:Key="StatusInfoBgColor">#EBF3FA</Color>
    <Color x:Key="StatusWarningColor">#C47B1B</Color>
    <Color x:Key="StatusWarningBgColor">#FDF4E7</Color>
    <Color x:Key="StatusErrorColor">#C44545</Color>
    <Color x:Key="StatusErrorBgColor">#FBECEC</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="{StaticResource StatusSuccessBgColor}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="{StaticResource StatusInfoBgColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="{StaticResource StatusWarningBgColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="{StaticResource StatusErrorBgColor}" />

    <!-- ================================================================
         SEMANTIC COMPONENT ALIASES (Mapped Strictly to Canonical Tokens)
         ================================================================ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource BgSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource BgSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource BrandTintColor}" />

    <!-- Permanent Left Sidebar Tokens (30% Secondary Surface + 10% Brand Tint Active) -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource BgSubtleColor}" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="SidebarSurfaceHoverBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="{StaticResource BrandTintColor}" />
    <SolidColorBrush x:Key="SidebarActiveBorderBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="SidebarActiveAccentBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SidebarSectionLabelBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderDefaultColor}" />

    <!-- Brand & Accents -->
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="{StaticResource BrandTintColor}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource StatusInfoColor}" />
    <SolidColorBrush x:Key="BrandSecondarySoftBrush" Color="{StaticResource StatusInfoBgColor}" />

    <!-- Typography Colors -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource BgSurfaceColor}" />

    <!-- Semantic & Clinical Safety Aliases -->
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource StatusErrorBgColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource StatusErrorColor}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="WarningPressedBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource StatusWarningBgColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource StatusWarningColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource StatusSuccessBgColor}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource StatusSuccessColor}" />

    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource StatusInfoColor}" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource StatusInfoBgColor}" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource StatusInfoColor}" />

    <!-- Dental Odontogram Condition Brushes (Strictly Mapped to Calm Dental Palette) -->
    <SolidColorBrush x:Key="ToothHealthyBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="ToothRootBrush" Color="{StaticResource StatusWarningBgColor}" />
    <SolidColorBrush x:Key="ToothCariesBrush" Color="{StaticResource StatusErrorBgColor}" />
    <SolidColorBrush x:Key="ToothFillingBrush" Color="{StaticResource StatusInfoBgColor}" />
    <SolidColorBrush x:Key="ToothCrownBrush" Color="{StaticResource StatusSuccessBgColor}" />
    <SolidColorBrush x:Key="ToothRootCanalBrush" Color="{StaticResource StatusWarningBgColor}" />
    <SolidColorBrush x:Key="ToothExtractionBrush" Color="{StaticResource StatusErrorBgColor}" />
    <SolidColorBrush x:Key="ToothMissingBrush" Color="{StaticResource BgSubtleColor}" />
    <SolidColorBrush x:Key="ToothImplantBrush" Color="{StaticResource BrandTintColor}" />

    <!-- Fonts & Resolution-Aware Sizing -->
    <FontFamily x:Key="FontFamilyPrimary">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Consolas</FontFamily>

    <sys:Double x:Key="FontSizePageTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeModalTitle">17</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">12.5</sys:Double>
    <sys:Double x:Key="FontSizeTableCell">12</sys:Double>
    <sys:Double x:Key="FontSizeTableHeader">11.5</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBadge">11</sys:Double>

    <sys:Double x:Key="TableRowHeight">36</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">36</sys:Double>
    <sys:Double x:Key="TableFooterHeight">42</sys:Double>

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">12</CornerRadius>
    <Thickness x:Key="CardPadding">14</Thickness>
    <Thickness x:Key="CompactCardPadding">10</Thickness>

    <!-- ================================================================
         GLOBAL SAFETY DEFAULTS (Zero Scrollbars, Zero Truncation, No Pure Black)
         ================================================================ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ================================================================
         TYPOGRAPHY STYLES
         ================================================================ -->
    <Style x:Key="UniformPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="UniformModalTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeModalTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="UniformSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="UniformLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTableHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="UniformBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="UniformMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="UniformMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTableCell}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- ================================================================
         CARD & CONTAINER STYLES (60% White Cards on #F7FAFA, 1px #D8E3E3)
         ================================================================ -->
    <Style x:Key="UniformCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="UniformSubtleCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}" />
    </Style>

    <!-- ================================================================
         BUTTON STYLES (Calm Dental Rules: 1 Primary CTA per View/Modal)
         ================================================================ -->
    <Style x:Key="UniformPrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UniformSecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderDefaultBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Soft Destructive Button for Inline Actions (#FBECEC bg + #C44545 text) -->
    <Style x:Key="UniformDangerButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
        <Setter Property="Background" Value="{StaticResource StatusErrorBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBgBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusErrorBgBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusErrorBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Solid Destructive Button Reserved Strictly for Final Confirmation Dialogs -->
    <Style x:Key="UniformDangerSolidButtonStyle" TargetType="Button" BasedOn="{StaticResource UniformPrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource StatusErrorBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calm Soft Warning Action Button (#FDF4E7 bg + #C47B1B text) -->
    <Style x:Key="UniformWarningButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
        <Setter Property="Background" Value="{StaticResource StatusWarningBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBgBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusWarningBgBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusWarningBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource StatusWarningBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusWarningBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UniformCompactSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource UniformSecondaryButtonStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="UniformSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource UniformSecondaryButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
