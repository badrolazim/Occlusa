<UserControl x:Class="Occlusa.Desktop.Controls.MedicalAlertsBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootBanner"
             Height="62"
             MinHeight="62"
             MaxHeight="62"
             ScrollViewer.VerticalScrollBarVisibility="Disabled"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border x:Name="BannerOuterBorder"
            Background="{Binding BannerBackground, ElementName=RootBanner}"
            BorderBrush="{Binding BannerBorderBrush, ElementName=RootBanner}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Clinical Accent Stripe -->
            <Border Grid.Column="0"
                    Background="{Binding BannerAccentBrush, ElementName=RootBanner}"
                    CornerRadius="8,0,0,8" />

            <!-- Idle State (No Patient Selected) -->
            <Grid Grid.Column="1"
                  Visibility="{Binding ShowIdleState, ElementName=RootBanner, Converter={StaticResource BoolToVis}}"
                  Margin="14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="CLINICAL SAFETY"
                                   FontFamily="{StaticResource FontFamilyPrimary}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="None" />
                    </Border>
                    <TextBlock Text="No active patient selected"
                               FontFamily="{StaticResource FontFamilyPrimary}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="None" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Select a patient row or scan a MyKad to inspect allergies, medical flags, and clinical safety notes."
                           FontFamily="{StaticResource FontFamilyPrimary}"
                           FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="None" />
            </Grid>

            <!-- Active Patient State -->
            <Grid Grid.Column="1"
                  Visibility="{Binding HasPatient, ElementName=RootBanner, Converter={StaticResource BoolToVis}}"
                  Margin="14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <!-- Row 0: Patient Identity + MyKad Verification Pill + Clinical Flag Pills -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding PatientName, ElementName=RootBanner}"
                                   FontFamily="{StaticResource FontFamilyPrimary}"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="None" />

                        <Border Background="{StaticResource BgSurfaceBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasIcNumber, ElementName=RootBanner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FormattedIcText, ElementName=RootBanner}"
                                       FontFamily="{StaticResource FontFamilyMono}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="None" />
                        </Border>

                        <!-- MyKad Verification Pill -->
                        <Border Background="{Binding MyKadBadgeBackground, ElementName=RootBanner}"
                                BorderBrush="{Binding MyKadBadgeBorder, ElementName=RootBanner}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding MyKadBadgeText, ElementName=RootBanner}"
                                       FontFamily="{StaticResource FontFamilyPrimary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MyKadBadgeForeground, ElementName=RootBanner}"
                                       VerticalAlignment="Center"
                                       TextTrimming="None" />
                        </Border>
                    </StackPanel>

                    <!-- Clinical Safety Alert Pills (Calm Semantic Soft Fill + Matching Text) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Clear State Pill -->
                        <Border Visibility="{Binding ShowClearBadge, ElementName=RootBanner, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource StatusSuccessBgBrush}"
                                BorderBrush="{StaticResource StatusSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="✓ NO CRITICAL MEDICAL ALERTS"
                                       FontFamily="{StaticResource FontFamilyPrimary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusSuccessBrush}"
                                       TextTrimming="None" />
                        </Border>

                        <!-- Allergy Pill -->
                        <Border Visibility="{Binding HasAllergies, ElementName=RootBanner, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding FullAllergyToolTip, ElementName=RootBanner}"
                                Background="{StaticResource StatusErrorBgBrush}"
                                BorderBrush="{StaticResource StatusErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormattedAllergyText, ElementName=RootBanner}"
                                       FontFamily="{StaticResource FontFamilyPrimary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource StatusErrorBrush}"
                                       TextTrimming="None" />
                        </Border>

                        <!-- Anticoagulants Pill -->
                        <Border Visibility="{Binding OnAnticoagulants, ElementName=RootBanner, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource StatusErrorBgBrush}"
                                BorderBrush="{StaticResource StatusErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="ANTICOAGULANTS (BLEEDING RISK)"
                                       FontFamily="{StaticResource FontFamilyPrimary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource StatusErrorBrush}"
                                       TextTrimming="None" />
                        </Border>

                        <!-- Diabetes Pill -->
                        <Border Visibility="{Binding HasDiabetes, ElementName=RootBanner, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource StatusWarningBgBrush}"
                                BorderBrush="{StaticResource StatusWarningBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="DIABETES"
                                       FontFamily="{StaticResource FontFamilyPrimary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource StatusWarningBrush}"
                                       TextTrimming="None" />
                        </Border>

                        <!-- Pregnancy Pill -->
                        <Border Visibility="{Binding IsPregnant, ElementName=RootBanner, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource StatusInfoBgBrush}"
                                BorderBrush="{StaticResource StatusInfoBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="PREGNANT"
                                       FontFamily="{StaticResource FontFamilyPrimary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource StatusInfoBrush}"
                                       TextTrimming="None" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Row 1: Alert Clinical Notes (Always reserved 20px slot so height never shifts) -->
                <TextBlock Grid.Row="1"
                           Text="{Binding FormattedAlertNotesText, ElementName=RootBanner}"
                           Foreground="{Binding AlertNotesForeground, ElementName=RootBanner}"
                           FontWeight="{Binding AlertNotesFontWeight, ElementName=RootBanner}"
                           ToolTip="{Binding FullAlertNotesToolTip, ElementName=RootBanner}"
                           FontFamily="{StaticResource FontFamilyPrimary}"
                           FontSize="11.5"
                           Margin="0,4,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="None" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
