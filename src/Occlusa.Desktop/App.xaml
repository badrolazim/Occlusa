<Application x:Class="Occlusa.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Occlusa.Desktop.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/UniformTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <services:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
            <services:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
            <services:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <services:ToothConditionToBrushConverter x:Key="ToothConditionToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
