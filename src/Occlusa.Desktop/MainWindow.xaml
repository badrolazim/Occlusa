<Window x:Class="Occlusa.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="Occlusa — Malaysian Dental Practice Management"
        Width="1600"
        Height="960"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource SurfaceCanvasBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================
             COLUMN 0: PERMANENT LEFT-SIDE NAVIGATION RAIL
             ================================================================ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,16">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="{StaticResource BrandPrimaryBrush}"
                            Margin="0,0,11,0">
                        <Path Data="M 18 8 V 28 M 8 18 H 28"
                              Stroke="{StaticResource TextInverseBrush}"
                              StrokeThickness="3.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="36"
                              Height="36" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OCCLUSA"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SidebarTextPrimaryBrush}" />
                        <TextBlock Text="Malaysian Dental PMS"
                                   FontSize="11"
                                   Foreground="{StaticResource SidebarTextMutedBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Branch Switcher & Active Staff Attribution -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="CLINIC BRANCH"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource SidebarSectionLabelBrush}"
                               Margin="4,0,0,5" />
                    <ComboBox ItemsSource="{Binding AvailableBranches}"
                              SelectedItem="{Binding SelectedBranchId}"
                              Style="{StaticResource UniformSidebarComboBoxStyle}"
                              Margin="0,0,0,10" />

                    <DockPanel LastChildFill="False" Margin="4,0,0,5">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="ACTIVE STAFF"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SidebarSectionLabelBrush}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="⚙ My View"
                                Click="OpenUserPreferencesButton_Click"
                                ToolTip="Configure your personal Simple / Detailed Live Queue view"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Padding="4,0"
                                Cursor="Hand"
                                VerticalAlignment="Center" />
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding StaffMembers}"
                              SelectedItem="{Binding SelectedStaffName}"
                              Style="{StaticResource UniformSidebarComboBoxStyle}" />
                </StackPanel>

                <!-- Permanent Left-Side Workspace Tabs -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACES"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource SidebarSectionLabelBrush}"
                               Margin="4,0,0,8" />

                    <!-- 1. Live Queue -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsQueueWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="0"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 Z M 12 6 V 12 L 16 14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Live Queue"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueueCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 2. Appointments -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsAppointmentsWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="1"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 5 4 H 19 C 20.1 4 21 4.9 21 6 V 20 C 21 21.1 20.1 22 19 22 H 5 C 3.9 22 3 21.1 3 20 V 6 C 3 4.9 3.9 4 5 4 Z M 16 2 V 6 M 8 2 V 6 M 3 10 H 21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Appointments"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppointmentCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 3. Patients Registry -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsPatientsWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="2"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 17 21 V 19 C 17 16.79 15.21 15 13 15 H 5 C 2.79 15 1 16.79 1 19 V 21 M 9 11 C 11.21 11 13 9.21 13 7 C 13 4.79 11.21 3 9 3 C 6.79 3 5 4.79 5 7 C 5 9.21 6.79 11 9 11 Z M 23 21 V 19 C 23 17.14 21.72 15.57 20 15.13 M 16 3.13 C 17.72 3.57 19 5.14 19 7 C 19 8.86 17.72 10.43 16 10.87"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Patients Registry"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PatientCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 4. Billing & Invoices -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsBillingWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="3"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 4 2 V 22 L 7 20 L 10 22 L 13 20 L 16 22 L 19 20 L 21 22 V 2 L 18 4 L 15 2 L 12 4 L 9 2 L 6 4 Z M 8 9 H 16 M 8 13 H 16 M 8 17 H 13"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Billing &amp; Invoices"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding InvoiceCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 5. WhatsApp AI -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsWhatsAppWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="4"
                                 Style="{StaticResource UniformNavTabRadioStyle}"
                                 Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 21 15 C 21 16.1 20.1 17 19 17 H 7 L 3 21 V 5 C 3 3.9 3.9 3 5 3 H 19 C 20.1 3 21 3.9 21 5 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="WhatsApp AI"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding WhatsAppCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 6. Master Catalogue & Doctor Settings -->
                    <RadioButton GroupName="MainWorkspaces"
                                 IsChecked="{Binding IsSettingsWorkspace, Mode=OneWay}"
                                 Command="{Binding SelectWorkspaceCommand}"
                                 CommandParameter="5"
                                 Style="{StaticResource UniformNavTabRadioStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12 15 C 13.66 15 15 13.66 15 12 C 15 10.34 13.66 9 12 9 C 10.34 9 9 10.34 9 12 C 9 13.66 10.34 15 12 15 Z M 19.4 15 L 21 16.5 L 19 19.8 L 16.9 19.1 C 16.2 19.6 15.5 20 14.7 20.3 L 14.3 22.5 H 9.7 L 9.3 20.3 C 8.5 20 7.8 19.6 7.1 19.1 L 5 19.8 L 3 16.5 L 4.6 15 C 4.5 14.5 4.5 13.5 4.6 13 L 3 11.5 L 5 8.2 L 7.1 8.9 C 7.8 8.4 8.5 8 9.3 7.7 L 9.7 5.5 H 14.3 L 14.7 7.7 C 15.5 8 16.2 8.4 16.9 8.9 L 19 8.2 L 21 11.5 L 19.4 13 C 19.5 13.5 19.5 14.5 19.4 15 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.9"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Master Catalogue"
                                       Margin="6,0,8,0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    MinWidth="26"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding BillingSettings.CatalogCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <!-- Urgent Triage & AI Booking Alert Shortcuts -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Button Command="{Binding SelectWorkspaceCommand}"
                            CommandParameter="4"
                            Visibility="{Binding HasEmergencyAlerts, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource UniformSidebarAlertDangerButtonStyle}"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="EMERGENCY ALERT"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextInverseBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="#991B1B"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding EmergencyAlertCount}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextInverseBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding SelectWorkspaceCommand}"
                            CommandParameter="0"
                            Visibility="{Binding HasAiBookedPending, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource UniformSidebarAlertWarningButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="AI-Booked Pending"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextInverseBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="#92400E"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AiBookedPendingCount}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextInverseBrush}" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom-Docked Connection & Sync Panel -->
                <Border Grid.Row="5"
                        Background="{StaticResource SidebarSurfaceBrush}"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F59E0B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSignalRConnected}" Value="True">
                                                <Setter Property="Fill" Value="#22C55E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionModeLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SidebarTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding DatabaseModeLabel, StringFormat='Storage: {0}'}"
                                   FontSize="11"
                                   Foreground="{StaticResource SidebarTextMutedBrush}"
                                   Margin="0,0,0,10" />

                        <Button Content="Sync Workspace"
                                Command="{Binding RefreshSnapshotCommand}"
                                Style="{StaticResource UniformSidebarActionButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================
             COLUMN 1: RIGHT CLINICAL WORKSPACE CANVAS
             ================================================================ -->
        <Grid Grid.Column="1" Margin="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Workspace Title, View Mode Pill & Optional MyKad Reader Controls -->
            <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}" Padding="16,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveWorkspaceTitle}"
                                   Style="{StaticResource UniformPageTitleTextStyle}"
                                   FontSize="18" />
                        <TextBlock Text="{Binding ActiveWorkspaceSubtitle}"
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Clickable View Mode Pill (Live Queue only) -->
                        <Button Content="{Binding QueueViewBadgeText}"
                                Click="OpenUserPreferencesButton_Click"
                                Visibility="{Binding IsQueueWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Click to switch between Simple and Detailed Live Queue views or customize your settings"
                                Style="{StaticResource UniformSecondaryButtonStyle}"
                                Height="32"
                                Padding="11,0"
                                FontSize="11.5"
                                Margin="0,0,8,0" />

                        <!-- Compact MyKad Action (Default when full MyKad bar is hidden for Reception) -->
                        <Button Content="MyKad ▾"
                                Click="CompactMyKadButton_Click"
                                Visibility="{Binding ShowCompactMyKadButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Read physical USB MyKad or simulate patient MyKad insert"
                                Style="{StaticResource UniformSecondaryButtonStyle}"
                                Height="32"
                                Padding="11,0"
                                FontSize="12" />

                        <!-- Full MyKad IC Bar (Opt-in via My View Settings) -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowFullMyKadBar, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="MyKad IC:"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding SimulatedProfileNames}"
                                      SelectedIndex="{Binding SelectedSimulatedProfileIndex}"
                                      Width="310"
                                      FontSize="12"
                                      Style="{StaticResource UniformComboBoxStyle}"
                                      Margin="0,0,8,0" />
                            <Button Content="Simulate Insert"
                                    Command="{Binding SimulateMyKadCommand}"
                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="Read USB"
                                    Command="{Binding ReadPhysicalMyKadCommand}"
                                    Style="{StaticResource UniformSecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Contextual Workspace Action Toolbar (Exact 32px Baseline Alignment) -->
            <Border Grid.Row="1" Style="{StaticResource UniformCardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <!-- 1A. Live Queue SIMPLE View Toolbar (Calm, Zero-Confusion Default) -->
                    <DockPanel Visibility="{Binding IsSimpleQueueToolbarVisible, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ShowDentistScopeToggle, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,0,10,0">
                                <RadioButton GroupName="SimpleQueueScope"
                                             Content="My Queue"
                                             IsChecked="{Binding IsMyQueueScope, Mode=OneWay}"
                                             Command="{Binding SetQueueScopeCommand}"
                                             CommandParameter="MyQueue"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                             Margin="0,0,4,0" />
                                <RadioButton GroupName="SimpleQueueScope"
                                             Content="All Clinic"
                                             IsChecked="{Binding IsAllClinicScope, Mode=OneWay}"
                                             Command="{Binding SetQueueScopeCommand}"
                                             CommandParameter="AllClinic"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}" />
                            </StackPanel>

                            <RadioButton GroupName="SimpleQueueFinishedFilter"
                                         Content="Active Only"
                                         IsChecked="{Binding IsActiveOnlyChecked, Mode=OneWay}"
                                         Command="{Binding SetShowFinishedQueueRowsCommand}"
                                         CommandParameter="False"
                                         Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                         Margin="0,0,4,0" />
                            <RadioButton GroupName="SimpleQueueFinishedFilter"
                                         Content="{Binding ShowDoneToggleLabel}"
                                         IsChecked="{Binding IsShowDoneChecked, Mode=OneWay}"
                                         Command="{Binding SetShowFinishedQueueRowsCommand}"
                                         CommandParameter="True"
                                         Style="{StaticResource UniformSegmentedToggleRadioStyle}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Walk-In"
                                    Click="NewWalkInButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />

                            <Button Content="Remind"
                                    Click="OpenSelectedQueueReminderButton_Click"
                                    Visibility="{Binding CanRemindSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource UniformWarningButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />

                            <Button Content="{Binding SmartNextActionLabel}"
                                    Click="SmartNextActionButton_Click"
                                    Visibility="{Binding HasSmartNextAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                    Height="32"
                                    Padding="13,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />

                            <Button Content="Clinical Chart"
                                    Click="OpenSelectedQueueOdontogramButton_Click"
                                    IsEnabled="{Binding HasSelectedQueueRow}"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="11,0"
                                    FontSize="12"
                                    Margin="0,0,6,0" />

                            <Button Content="Details"
                                    Click="OpenSelectedQueueVisitButton_Click"
                                    IsEnabled="{Binding HasSelectedQueueRow}"
                                    Style="{StaticResource UniformGhostButtonStyle}"
                                    Height="32"
                                    Padding="10,0"
                                    FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 1B. Live Queue DETAILED Operations Toolbar (Opt-In via My View Settings) -->
                    <StackPanel Visibility="{Binding IsDetailedQueueToolbarVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Row A: Direct Stage Controls & Clinical Modals -->
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ Walk-In"
                                        Click="NewWalkInButton_Click"
                                        Style="{StaticResource UniformPrimaryButtonStyle}"
                                        Height="32"
                                        Padding="12,0"
                                        FontSize="12"
                                        Margin="0,0,6,0" />

                                <Button Content="Approve AI"
                                        Command="{Binding ApproveSelectedAiBookingCommand}"
                                        Visibility="{Binding CanApproveSelectedAi, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource UniformWarningButtonStyle}"
                                        Height="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,0,6,0" />

                                <Button Content="Remind"
                                        Click="OpenSelectedQueueReminderButton_Click"
                                        IsEnabled="{Binding CanRemindSelected}"
                                        Style="{StaticResource UniformSecondaryButtonStyle}"
                                        Height="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,0,8,0" />

                                <Border Width="1"
                                        Height="20"
                                        Background="{StaticResource BorderHairlineBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />

                                <Button Content="Check In"
                                        Command="{Binding AdvanceQueueStatusCommand}"
                                        CommandParameter="Waiting"
                                        IsEnabled="{Binding CanCheckInSelected}"
                                        Style="{StaticResource UniformSegmentButtonStyle}"
                                        Margin="0,0,4,0" />
                                <Button Content="In Chair"
                                        Command="{Binding AdvanceQueueStatusCommand}"
                                        CommandParameter="InChair"
                                        IsEnabled="{Binding CanCallToChairSelected}"
                                        Style="{StaticResource UniformSegmentButtonStyle}"
                                        Margin="0,0,4,0" />
                                <Button Content="Checkout"
                                        Click="CheckoutSelectedQueuePatientButton_Click"
                                        IsEnabled="{Binding CanSendToCheckoutSelected}"
                                        Style="{StaticResource UniformSegmentButtonStyle}"
                                        Margin="0,0,4,0" />
                                <Button Content="Complete"
                                        Command="{Binding AdvanceQueueStatusCommand}"
                                        CommandParameter="Completed"
                                        IsEnabled="{Binding CanCompleteSelected}"
                                        Style="{StaticResource UniformSegmentButtonStyle}"
                                        Margin="0,0,4,0" />
                                <Button Content="Cancel"
                                        Command="{Binding CancelSelectedQueueItemCommand}"
                                        IsEnabled="{Binding CanCancelSelectedQueue}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Style="{StaticResource UniformGhostButtonStyle}"
                                        Height="32"
                                        Padding="8,0"
                                        FontSize="12" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Appointment"
                                        Click="OpenSelectedQueueVisitButton_Click"
                                        IsEnabled="{Binding HasSelectedQueueRow}"
                                        Style="{StaticResource UniformSecondaryButtonStyle}"
                                        Height="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,0,6,0" />
                                <Button Content="Patient Profile"
                                        Click="OpenSelectedQueuePatientButton_Click"
                                        IsEnabled="{Binding HasSelectedQueueRow}"
                                        Style="{StaticResource UniformSecondaryButtonStyle}"
                                        Height="32"
                                        Padding="10,0"
                                        FontSize="12"
                                        Margin="0,0,6,0" />
                                <Button Content="Clinical Chart"
                                        Click="OpenSelectedQueueOdontogramButton_Click"
                                        IsEnabled="{Binding HasSelectedQueueRow}"
                                        Style="{StaticResource UniformPrimaryButtonStyle}"
                                        Height="32"
                                        Padding="10,0"
                                        FontSize="12" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Row B: Doctor Dropdown, Quick Status Filter Chips & Finished-Row Toggle -->
                        <DockPanel LastChildFill="False" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Doctor:"
                                           Style="{StaticResource UniformLabelTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding QueueDoctorFilterOptions}"
                                          SelectedItem="{Binding SelectedQueueDoctorFilter, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          Width="185"
                                          Height="30"
                                          FontSize="12"
                                          Style="{StaticResource UniformComboBoxStyle}"
                                          Margin="0,0,12,0" />

                                <RadioButton GroupName="DetailedStatusChips"
                                             Content="All"
                                             IsChecked="{Binding IsStatusChipAll, Mode=OneWay}"
                                             Command="{Binding SetQueueStatusChipCommand}"
                                             CommandParameter="All"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                             Margin="0,0,4,0" />
                                <RadioButton GroupName="DetailedStatusChips"
                                             Content="Waiting"
                                             IsChecked="{Binding IsStatusChipWaiting, Mode=OneWay}"
                                             Command="{Binding SetQueueStatusChipCommand}"
                                             CommandParameter="Waiting"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                             Margin="0,0,4,0" />
                                <RadioButton GroupName="DetailedStatusChips"
                                             Content="In Chair"
                                             IsChecked="{Binding IsStatusChipInChair, Mode=OneWay}"
                                             Command="{Binding SetQueueStatusChipCommand}"
                                             CommandParameter="InChair"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                             Margin="0,0,4,0" />
                                <RadioButton GroupName="DetailedStatusChips"
                                             Content="Checkout"
                                             IsChecked="{Binding IsStatusChipCheckout, Mode=OneWay}"
                                             Command="{Binding SetQueueStatusChipCommand}"
                                             CommandParameter="Checkout"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                             Margin="0,0,4,0" />
                                <RadioButton GroupName="DetailedStatusChips"
                                             Content="Unreminded"
                                             IsChecked="{Binding IsStatusChipUnreminded, Mode=OneWay}"
                                             Command="{Binding SetQueueStatusChipCommand}"
                                             CommandParameter="Unreminded"
                                             Style="{StaticResource UniformSegmentedToggleRadioStyle}" />
                            </StackPanel>

                            <CheckBox DockPanel.Dock="Right"
                                      Content="{Binding ShowDoneToggleLabel}"
                                      IsChecked="{Binding ShowFinishedQueueRows, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource UniformCheckBoxStyle}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- 2. Appointments Tab Actions -->
                    <Grid Visibility="{Binding IsAppointmentsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding Appointments}">
                            <!-- Row A: Display Mode, Date Navigation, Range Switcher, Day Slot Zoom, New Appt -->
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton GroupName="ApptDisplayMode"
                                                 Content="Calendar"
                                                 IsChecked="{Binding IsCalendarMode, Mode=OneWay}"
                                                 Command="{Binding SetDisplayModeCommand}"
                                                 CommandParameter="Calendar"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptDisplayMode"
                                                 Content="Table"
                                                 IsChecked="{Binding IsTableMode, Mode=OneWay}"
                                                 Command="{Binding SetDisplayModeCommand}"
                                                 CommandParameter="Table"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,10,0" />

                                    <Border Width="1"
                                            Height="20"
                                            Background="{StaticResource BorderHairlineBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />

                                    <Button Content="◀"
                                            Command="{Binding PrevRangeCommand}"
                                            Style="{StaticResource UniformSegmentButtonStyle}"
                                            Width="32"
                                            Padding="0"
                                            Margin="0,0,4,0" />
                                    <Button Content="Today"
                                            Command="{Binding TodayCommand}"
                                            Style="{StaticResource UniformSegmentButtonStyle}"
                                            Margin="0,0,4,0" />
                                    <Button Content="▶"
                                            Command="{Binding NextRangeCommand}"
                                            Style="{StaticResource UniformSegmentButtonStyle}"
                                            Width="32"
                                            Padding="0"
                                            Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding ActiveRangeTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />

                                    <Border Width="1"
                                            Height="20"
                                            Background="{StaticResource BorderHairlineBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />

                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="Day"
                                                 IsChecked="{Binding IsRangeDayChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="Day"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="Week"
                                                 IsChecked="{Binding IsRangeWeekChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="Week"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="Month"
                                                 IsChecked="{Binding IsRangeMonthChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="Month"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />
                                    <RadioButton GroupName="ApptRangeMode"
                                                 Content="All"
                                                 Visibility="{Binding IsTableMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 IsChecked="{Binding IsRangeAllChecked, Mode=OneWay}"
                                                 Command="{Binding SetRangeModeCommand}"
                                                 CommandParameter="All"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,4,0" />

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsTimelineCalendarView, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="6,0,0,0">
                                        <Border Width="1"
                                                Height="20"
                                                Background="{StaticResource BorderHairlineBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0" />
                                        <RadioButton GroupName="ApptDaySession"
                                                     Content="Full Day"
                                                     IsChecked="{Binding IsFullDaySession, Mode=OneWay}"
                                                     Command="{Binding SetDaySessionCommand}"
                                                     CommandParameter="FullDay"
                                                     Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                     Margin="0,0,4,0" />
                                        <RadioButton GroupName="ApptDaySession"
                                                     Content="AM"
                                                     IsChecked="{Binding IsMorningSession, Mode=OneWay}"
                                                     Command="{Binding SetDaySessionCommand}"
                                                     CommandParameter="Morning"
                                                     Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                     Margin="0,0,4,0" />
                                        <RadioButton GroupName="ApptDaySession"
                                                     Content="PM"
                                                     IsChecked="{Binding IsAfternoonSession, Mode=OneWay}"
                                                     Command="{Binding SetDaySessionCommand}"
                                                     CommandParameter="Afternoon"
                                                     Style="{StaticResource UniformSegmentedToggleRadioStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Content="+ New Appointment"
                                        Click="NewAppointmentButton_Click"
                                        Style="{StaticResource UniformPrimaryButtonStyle}"
                                        Height="32"
                                        Padding="12,0"
                                        FontSize="12" />
                            </DockPanel>

                            <!-- Row B: Step 1 (Treatment) -> Step 2 (Qualified Dentist) -> Patient Filters -->
                            <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Treatment:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding TreatmentFilterOptions}"
                                              SelectedItem="{Binding SelectedTreatmentFilter, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Width="205"
                                              Height="32"
                                              FontSize="12"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,12,0" />

                                    <TextBlock Text="Dentist:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding DentistFilterOptions}"
                                              SelectedItem="{Binding SelectedDentistFilter, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Width="195"
                                              Height="32"
                                              FontSize="12"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,12,0" />

                                    <TextBlock Text="Patient:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Text="{Binding PatientFilterText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="190"
                                             Height="32"
                                             Style="{StaticResource UniformInputTextBoxStyle}"
                                             Margin="0,0,6,0" />

                                    <Button Content="Clear"
                                            Command="{Binding ClearFiltersCommand}"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource UniformGhostButtonStyle}"
                                            Height="32" />
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FilteredSummaryLabel}"
                                           Style="{StaticResource UniformMutedTextStyle}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Patients Tab Actions -->
                    <DockPanel Visibility="{Binding IsPatientsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter Patients:"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding PatientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"
                                     Height="32"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,6,0" />
                            <Button Content="Clear"
                                    Command="{Binding ClearPatientSearchCommand}"
                                    Visibility="{Binding PatientSearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                    Style="{StaticResource UniformGhostButtonStyle}"
                                    Height="32" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Register Patient"
                                    Click="RegisterStandalonePatientButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="+ Register &amp; Book"
                                    Click="RegisterPatientAndBookButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="Check-In to Queue"
                                    Command="{Binding CheckInSelectedPatientCommand}"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="Open Patient Profile"
                                    Click="OpenSelectedPatientButton_Click"
                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 4. Billing Tab Actions -->
                    <DockPanel Visibility="{Binding IsBillingWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Decoupled from Doctor's Notes · OTC 0% Commission · Shared Patient Credit Wallet"
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Walk-In OTC Sale"
                                    Click="NewRetailInvoiceButton_Click"
                                    Style="{StaticResource UniformPrimaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="+ Patient Invoice"
                                    Click="NewPatientInvoiceButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="Open Invoice"
                                    Click="OpenSelectedInvoiceButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="End-of-Day Reconciliation"
                                    Click="OpenDailyReconciliationButton_Click"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 5. WhatsApp Tab Actions -->
                    <DockPanel Visibility="{Binding IsWhatsAppWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="AI bookings default to AiBookedPending. Emergency red flags immediately halt booking and escalate."
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="Open WhatsApp Simulator &amp; Staff Takeover"
                                Click="OpenWhatsAppConsoleButton_Click"
                                Style="{StaticResource UniformPrimaryButtonStyle}"
                                Height="32"
                                Padding="14,0"
                                FontSize="12" />
                    </DockPanel>

                    <!-- 6. Master Catalogue & Doctor Settings Tab Actions -->
                    <Grid Visibility="{Binding IsSettingsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding BillingSettings}">
                            <!-- Row A: Sub-Tab Switcher & Primary Actions -->
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton GroupName="SettingsSubTabs"
                                                 Content="1. Master Catalogue (Appts, Chart &amp; Prices)"
                                                 IsChecked="{Binding IsCatalogSubTab, Mode=OneWay}"
                                                 Command="{Binding SetSubTabCommand}"
                                                 CommandParameter="0"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}"
                                                 Margin="0,0,6,0" />
                                    <RadioButton GroupName="SettingsSubTabs"
                                                 Content="2. Doctor Invoice Modes &amp; Suggestions"
                                                 IsChecked="{Binding IsDoctorRulesSubTab, Mode=OneWay}"
                                                 Command="{Binding SetSubTabCommand}"
                                                 CommandParameter="1"
                                                 Style="{StaticResource UniformSegmentedToggleRadioStyle}" />
                                </StackPanel>

                                <!-- Catalog Sub-Tab Primary Actions -->
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCatalogSubTab, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Edit Selected"
                                            Command="{Binding RequestEditSelectedCatalogItemCommand}"
                                            Style="{StaticResource UniformSecondaryButtonStyle}"
                                            Height="32"
                                            Padding="11,0"
                                            FontSize="12"
                                            Margin="0,0,8,0" />
                                    <Button Content="+ Add Catalogue Item"
                                            Command="{Binding RequestNewCatalogItemCommand}"
                                            Style="{StaticResource UniformPrimaryButtonStyle}"
                                            Height="32"
                                            Padding="12,0"
                                            FontSize="12" />
                                </StackPanel>

                                <!-- Doctor Rules Sub-Tab Primary Actions -->
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsDoctorRulesSubTab, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Save Mode"
                                            Click="SaveDoctorModeButton_Click"
                                            Style="{StaticResource UniformSecondaryButtonStyle}"
                                            Height="32"
                                            Padding="11,0"
                                            FontSize="12"
                                            Margin="0,0,8,0" />
                                    <Button Content="Configure Add-Ons"
                                            Command="{Binding RequestEditSelectedRuleCommand}"
                                            Style="{StaticResource UniformPrimaryButtonStyle}"
                                            Height="32"
                                            Padding="12,0"
                                            FontSize="12" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Row B: Contextual Filter / Doctor Scope Controls -->
                            <DockPanel Margin="0,8,0,0"
                                       LastChildFill="False"
                                       Visibility="{Binding IsCatalogSubTab, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Filter:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding CategoryFilterOptions}"
                                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                              Width="200"
                                              Height="30"
                                              FontSize="12"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,10,0" />
                                    <TextBlock Text="Search:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBox Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260"
                                             Height="30"
                                             ToolTip="Filter catalogue items, subcategories, or note keywords"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="Single source of truth for Appointments, Odontogram Presets, Billing &amp; WhatsApp AI"
                                           Style="{StaticResource UniformMutedTextStyle}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Margin="0,8,0,0"
                                       LastChildFill="False"
                                       Visibility="{Binding IsDoctorRulesSubTab, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Scope:" Style="{StaticResource UniformLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding DoctorScopes}"
                                              SelectedItem="{Binding SelectedDoctorScope, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Width="220"
                                              Height="30"
                                              FontSize="12"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,14,0" />

                                    <TextBlock Text="Checkout Mode:" Style="{StaticResource UniformLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding InitModeOptions}"
                                              SelectedItem="{Binding SelectedInitModeOption, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Width="230"
                                              Height="30"
                                              FontSize="12"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,14,0" />

                                    <CheckBox Content="Scan Dr Notes Automatically"
                                              IsChecked="{Binding EnableNoteKeywordEngine, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource UniformCheckBoxStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: Workspace Content Tables & Calendar (Auto 11 rows @ 1080p, 17 rows @ 1440p) -->
            <Grid Grid.Row="2">
                <!-- 1. Live Queue Split Container: Left-Docked Content-Sized Table + Empty Right Panel -->
                <Grid Visibility="{Binding IsQueueWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Compact Content-Fitted Live Queue Table -->
                    <Grid Grid.Column="0" HorizontalAlignment="Left">
                        <!-- 1A. Live Queue SIMPLE View (Default: Strictly 4 Columns — Time · Patient · Reminder · Status) -->
                        <controls:UniformPagedGrid x:Name="SimpleQueuePagedGrid"
                                                   Visibility="{Binding IsQueueSimpleGridVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Title="{Binding QueueGridTitle}"
                                                   Subtitle="{Binding QueuePulseSummary}"
                                                   EmptyMessage="No active patients in queue — click + Walk-In or switch to Show Done."
                                                   HorizontalAlignment="Left"
                                                   MinWidth="480"
                                                   EnforceColumnLimit="True"
                                                   AllowAutoRowHeight="True"
                                                   FitColumnsToContent="True"
                                                   RowSpacing="4"
                                                   ItemsSource="{Binding QueueRows}"
                                                   SelectedItem="{Binding SelectedQueueRow, Mode=TwoWay}"
                                                   RowDoubleClicked="QueuePagedGrid_RowDoubleClicked">
                            <controls:UniformColumnDef Header="Time" MinWidth="72">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,5,22,5"
                                              Background="Transparent"
                                              Opacity="{Binding RowContentOpacity}"
                                              ToolTip="{Binding ToolTipText}">
                                            <TextBlock Text="{Binding SimpleTimeDisplay}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="None">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                                        <Setter Property="FontSize" Value="12.5" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWalkIn}" Value="True">
                                                                <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
                                                                <Setter Property="FontSize" Value="11.5" />
                                                                <Setter Property="Foreground" Value="#B45309" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>

                            <controls:UniformColumnDef Header="Patient" MinWidth="180">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              Opacity="{Binding RowContentOpacity}"
                                              ToolTip="{Binding ToolTipText}">
                                            <StackPanel Orientation="Vertical"
                                                        Margin="14,5,26,5"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PatientNameDisplay}"
                                                               FontFamily="{StaticResource FontFamilyPrimary}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="None" />
                                                    <Border Visibility="{Binding HasCriticalAlert, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="#FEF2F2"
                                                            BorderBrush="#FECACA"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="5,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="ALERT"
                                                                   FontSize="9.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="#DC2626"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="None" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SimplePatientSubline}"
                                                           FontFamily="{StaticResource FontFamilyPrimary}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,1,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="None" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>

                            <controls:UniformColumnDef Header="Reminder" MinWidth="126">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,5,22,5"
                                              Background="Transparent"
                                              Opacity="{Binding RowContentOpacity}"
                                              ToolTip="{Binding ToolTipText}">
                                            <Border Background="{Binding ReminderBadgeBackground}"
                                                    BorderBrush="{Binding ReminderBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="11"
                                                    MinWidth="106"
                                                    Height="23"
                                                    Padding="9,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Fill="{Binding ReminderDotBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding ReminderDisplay}"
                                                               FontFamily="{StaticResource FontFamilyPrimary}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding ReminderBadgeForeground}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="None" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>

                            <controls:UniformColumnDef Header="Status" MinWidth="118">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,5,18,5"
                                              Background="Transparent"
                                              ToolTip="{Binding ToolTipText}">
                                            <Border Background="{Binding StatusBadgeBackground}"
                                                    BorderBrush="{Binding StatusBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    MinWidth="104"
                                                    Height="24"
                                                    Padding="10,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="{Binding StatusDotBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               FontFamily="{StaticResource FontFamilyPrimary}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBadgeForeground}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="None" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>
                        </controls:UniformPagedGrid>

                        <!-- 1B. Live Queue DETAILED Operations View (Opt-In: 5 Compact Content-Fitted Columns) -->
                        <controls:UniformPagedGrid x:Name="DetailedQueuePagedGrid"
                                                   Visibility="{Binding IsQueueDetailedGridVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Title="{Binding QueueGridTitle}"
                                                   Subtitle="{Binding QueuePulseSummary}"
                                                   EmptyMessage="No matching patients in today's queue — adjust filters or click + Walk-In."
                                                   HorizontalAlignment="Left"
                                                   MinWidth="660"
                                                   EnforceColumnLimit="False"
                                                   AllowAutoRowHeight="True"
                                                   FitColumnsToContent="True"
                                                   RowSpacing="4"
                                                   ItemsSource="{Binding QueueRows}"
                                                   SelectedItem="{Binding SelectedQueueRow, Mode=TwoWay}"
                                                   RowDoubleClicked="QueuePagedGrid_RowDoubleClicked">
                            <controls:UniformColumnDef Header="Appt / Arrived" MinWidth="92">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,5,22,5"
                                              Background="Transparent"
                                              Opacity="{Binding RowContentOpacity}"
                                              ToolTip="{Binding ToolTipText}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StackedTimePrimaryDisplay}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="None">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWalkIn}" Value="True">
                                                                    <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StackedTimeSecondaryDisplay}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,1,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="None" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>

                            <controls:UniformColumnDef Header="Patient &amp; Note" MinWidth="180">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              Opacity="{Binding RowContentOpacity}"
                                              ToolTip="{Binding ToolTipText}">
                                            <StackPanel Orientation="Vertical"
                                                        Margin="14,5,26,5"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PatientNameDisplay}"
                                                               FontFamily="{StaticResource FontFamilyPrimary}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="None" />
                                                    <Border Visibility="{Binding HasCriticalAlert, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="#FEF2F2"
                                                            BorderBrush="#FECACA"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="5,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="ALERT"
                                                                   FontSize="9.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="#DC2626"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="None" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailedPatientSubline}"
                                                           Visibility="{Binding HasDetailedPatientSubline, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           FontFamily="{StaticResource FontFamilyPrimary}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,1,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="None" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>

                            <controls:UniformColumnDef Header="Doctor &amp; Room" MinWidth="140">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,5,22,5"
                                              Background="Transparent"
                                              Opacity="{Binding RowContentOpacity}"
                                              ToolTip="{Binding ToolTipText}">
                                            <TextBlock Text="{Binding DoctorRoomDisplay}"
                                                       FontFamily="{StaticResource FontFamilyPrimary}"
                                                       FontSize="12"
                                                       Foreground="#334155"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="None" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>

                            <controls:UniformColumnDef Header="Reminder" MinWidth="120">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,5,20,5"
                                              Background="Transparent"
                                              Opacity="{Binding RowContentOpacity}"
                                              ToolTip="{Binding ToolTipText}">
                                            <Border Background="{Binding ReminderBadgeBackground}"
                                                    BorderBrush="{Binding ReminderBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="11"
                                                    MinWidth="104"
                                                    Height="23"
                                                    Padding="8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Fill="{Binding ReminderDotBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding ReminderDisplay}"
                                                               FontFamily="{StaticResource FontFamilyPrimary}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding ReminderBadgeForeground}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="None" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>

                            <controls:UniformColumnDef Header="Status" MinWidth="128">
                                <controls:UniformColumnDef.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="14,5,18,5"
                                              Background="Transparent"
                                              ToolTip="{Binding ToolTipText}">
                                            <Border Background="{Binding StatusBadgeBackground}"
                                                    BorderBrush="{Binding StatusBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    MinWidth="112"
                                                    Height="24"
                                                    Padding="9,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="{Binding StatusDotBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               FontFamily="{StaticResource FontFamilyPrimary}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBadgeForeground}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="None" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </controls:UniformColumnDef.CellTemplate>
                            </controls:UniformColumnDef>
                        </controls:UniformPagedGrid>
                    </Grid>

                    <!-- Right Panel: Intentionally left empty for future contextual preview / workspace -->
                    <Grid Grid.Column="1" />
                </Grid>

                <!-- 2. Appointments (Calendar + Paged Table) -->
                <Grid Visibility="{Binding IsAppointmentsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:AppointmentsWorkspaceView x:Name="AppointmentsWorkspace"
                                                        DataContext="{Binding Appointments}" />
                </Grid>

                <!-- 3. Patients Registry -->
                <controls:UniformPagedGrid x:Name="PatientsPagedGrid"
                                           Visibility="{Binding IsPatientsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Title="Malaysian Patients Registry"
                                           Subtitle="Double-click any patient for Demographics, 0..N Visit Records &amp; Per-Visit Odontograms"
                                           EmptyMessage="No matching patients found."
                                           ItemsSource="{Binding PatientRows}"
                                           SelectedItem="{Binding SelectedPatientRow, Mode=TwoWay}"
                                           RowDoubleClicked="PatientsPagedGrid_RowDoubleClicked">
                    <controls:UniformColumnDef Header="IC / MyKad" BindingPath="IcDisplay" WidthRatio="1.2" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Full Name" BindingPath="FullName" WidthRatio="2.0" IsBold="True" />
                    <controls:UniformColumnDef Header="Phone &amp; Visits" BindingPath="ContactVisitsDisplay" WidthRatio="1.45" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Alerts" BindingPath="AlertsDisplay" WidthRatio="1.65" />
                </controls:UniformPagedGrid>

                <!-- 3. Billing & Invoices -->
                <controls:UniformPagedGrid x:Name="InvoicesPagedGrid"
                                           Visibility="{Binding IsBillingWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Title="Reception Billing &amp; Invoices"
                                           Subtitle="Double-click any invoice for Split-Payment Checkout &amp; Soft-Void"
                                           EmptyMessage="No invoices recorded for this branch yet."
                                           ItemsSource="{Binding InvoiceRows}"
                                           SelectedItem="{Binding SelectedInvoiceRow, Mode=TwoWay}"
                                           RowDoubleClicked="InvoicesPagedGrid_RowDoubleClicked">
                    <controls:UniformColumnDef Header="Invoice #" BindingPath="InvoiceNumber" WidthRatio="1.3" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Patient" BindingPath="PatientName" WidthRatio="2.1" IsBold="True" />
                    <controls:UniformColumnDef Header="Payable (RM)" BindingPath="PayableDisplay" WidthRatio="1.1" IsMonospace="True" HorizontalAlignment="Right" />
                    <controls:UniformColumnDef Header="Status" BindingPath="StatusDisplay" WidthRatio="1.3" />
                </controls:UniformPagedGrid>

                <!-- 5. WhatsApp AI Console -->
                <controls:UniformPagedGrid x:Name="WhatsAppPagedGrid"
                                           Visibility="{Binding IsWhatsAppWorkspace, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Title="WhatsApp AI Receptionist Threads"
                                           Subtitle="Double-click any thread for Paged Transcript, Simulator &amp; Emergency Takeover"
                                           EmptyMessage="No WhatsApp conversations yet — open Simulator to test AI triage."
                                           ItemsSource="{Binding WhatsAppRows}"
                                           SelectedItem="{Binding SelectedWhatsAppRow, Mode=TwoWay}"
                                           RowDoubleClicked="WhatsAppPagedGrid_RowDoubleClicked">
                    <controls:UniformColumnDef Header="Phone / Patient" BindingPath="ContactDisplay" WidthRatio="2.1" IsBold="True" />
                    <controls:UniformColumnDef Header="Last Update" BindingPath="LastUpdatedDisplay" WidthRatio="1.2" IsMonospace="True" />
                    <controls:UniformColumnDef Header="Triage" BindingPath="TriageDisplay" WidthRatio="1.1" />
                    <controls:UniformColumnDef Header="State" BindingPath="StateDisplay" WidthRatio="1.2" />
                </controls:UniformPagedGrid>

                <!-- 6. Unified Master Catalogue & Doctor Invoice Suggestions -->
                <Grid Visibility="{Binding IsSettingsWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid DataContext="{Binding BillingSettings}">
                        <controls:UniformPagedGrid x:Name="BillingCatalogPagedGrid"
                                                   Visibility="{Binding IsCatalogSubTab, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Title="Unified Master Catalogue (Appointments · Odontogram · Billing · AI Quotes)"
                                                   Subtitle="Single source of truth — double-click any item to edit Price, Appointment Booking, Odontogram Preset, or SOAP Keywords"
                                                   EmptyMessage="No matching catalogue items found."
                                                   ItemsSource="{Binding CatalogRows}"
                                                   SelectedItem="{Binding SelectedCatalogRow, Mode=TwoWay}"
                                                   RowDoubleClicked="BillingCatalogPagedGrid_RowDoubleClicked">
                            <controls:UniformColumnDef Header="Catalogue Item" BindingPath="Name" WidthRatio="1.95" IsBold="True" />
                            <controls:UniformColumnDef Header="Usage &amp; Commission" BindingPath="CategoryDisplay" WidthRatio="1.7" />
                            <controls:UniformColumnDef Header="SOAP Note Keywords" BindingPath="KeywordsDisplay" WidthRatio="1.7" IsMonospace="True" />
                            <controls:UniformColumnDef Header="Unit Price" BindingPath="PriceDisplay" WidthRatio="0.9" IsMonospace="True" HorizontalAlignment="Right" />
                        </controls:UniformPagedGrid>

                        <controls:UniformPagedGrid x:Name="DoctorRulesPagedGrid"
                                                   Visibility="{Binding IsDoctorRulesSubTab, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Title="Treatment → Companion Invoice Item Suggestions"
                                                   Subtitle="Double-click any treatment to customize suggested painkillers, X-rays, or OTC products for the selected Doctor Scope"
                                                   EmptyMessage="No clinical treatments configured."
                                                   ItemsSource="{Binding RuleRows}"
                                                   SelectedItem="{Binding SelectedRuleRow, Mode=TwoWay}"
                                                   RowDoubleClicked="DoctorRulesPagedGrid_RowDoubleClicked">
                            <controls:UniformColumnDef Header="Primary Treatment" BindingPath="TreatmentName" WidthRatio="1.85" IsBold="True" />
                            <controls:UniformColumnDef Header="Rule Scope" BindingPath="RuleSourceDisplay" WidthRatio="1.1" />
                            <controls:UniformColumnDef Header="Suggested Companion Invoice Items" BindingPath="SuggestedSummary" WidthRatio="2.45" />
                            <controls:UniformColumnDef Header="Add-Ons" BindingPath="CountDisplay" WidthRatio="0.8" IsMonospace="True" HorizontalAlignment="Right" />
                        </controls:UniformPagedGrid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Row 3: Clean Status Footer Strip -->
            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,7"
                    Margin="0,10,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{Binding MyKadReaderStatus}"
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  ·  Double-click any row to open details"
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource UniformMutedTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
