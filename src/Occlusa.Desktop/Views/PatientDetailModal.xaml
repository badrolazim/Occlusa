<Window x:Class="Occlusa.Desktop.Views.PatientDetailModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="Patient Profile &amp; Visit Registry"
        Width="1240"
        Height="840"
        MinWidth="1080"
        MinHeight="750"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceCanvasBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <controls:ModalDialogShell x:Name="DialogShell"
                               Title="{Binding ModalTitle}"
                               Subtitle="{Binding ModalSubtitle}"
                               BadgeText="{Binding MyKadBadgeLabel}"
                               HasUnsavedChanges="{Binding HasUnsavedChanges, Mode=TwoWay}"
                               SaveCommand="{Binding SaveAllChangesCommand}"
                               UnsavedPromptTitle="Unsaved Patient Profile Changes"
                               UnsavedPromptMessage="You have unsaved patient demographic or medical alert edits. Save changes before closing?">

        <controls:ModalDialogShell.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Pinned Clinical Safety Banner -->
                <controls:MedicalAlertsBanner Grid.Row="0"
                                              Margin="0,0,0,12"
                                              PatientName="{Binding FullName}"
                                              IcNumber="{Binding IcNumber}"
                                              IsMyKadVerified="{Binding Patient.IsMyKadVerified}"
                                              Allergies="{Binding Allergies}"
                                              OnAnticoagulants="{Binding OnAnticoagulants}"
                                              HasDiabetes="{Binding HasDiabetes}"
                                              IsPregnant="{Binding IsPregnant}"
                                              AlertNotes="{Binding AlertNotes}" />

                <!-- Two-Column Workspace: Left = Editable Patient Registry Profile · Right = 0..N Visit Records -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Full Patient Demographics, Medical Safety Flags & PDPA Consent -->
                    <Border Grid.Column="0" Style="{StaticResource UniformCardBorderStyle}" Padding="14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Patient Demographics &amp; Safety"
                                           Style="{StaticResource UniformSectionTitleTextStyle}"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Content="Sign PDPA Consent"
                                        Command="{Binding SignConsentCommand}"
                                        Visibility="{Binding CanSignConsent, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource UniformCompactSecondaryButtonStyle}" />
                            </DockPanel>

                            <TextBlock Text="{Binding ConsentStatusText}"
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Full Name *" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="IC / Passport # *" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding IcNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phone" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding NricHintText}"
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Date of Birth" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <DatePicker SelectedDate="{Binding DateOfBirthInput, Mode=TwoWay}"
                                                Height="32"
                                                VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Gender" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableGenders}"
                                              SelectedItem="{Binding Gender, Mode=TwoWay}"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Branch" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableBranches}"
                                              SelectedItem="{Binding PrimaryBranchId, Mode=TwoWay}"
                                              Style="{StaticResource UniformComboBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Residential Address" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,0,10" />

                            <Border Height="1" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="Drug / Latex Allergies" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Allergies, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformInputTextBoxStyle}"
                                     Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          Content="Anticoagulants"
                                          IsChecked="{Binding OnAnticoagulants}"
                                          Style="{StaticResource UniformCheckBoxStyle}" />
                                <CheckBox Grid.Column="1"
                                          Content="Diabetes"
                                          IsChecked="{Binding HasDiabetes}"
                                          Style="{StaticResource UniformCheckBoxStyle}" />
                                <CheckBox Grid.Column="2"
                                          Content="Pregnant"
                                          IsChecked="{Binding IsPregnant}"
                                          Style="{StaticResource UniformCheckBoxStyle}" />
                            </Grid>

                            <TextBlock Text="Clinical Safety Notes" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding AlertNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformInputTextBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- RIGHT COLUMN: Chronological Visit Records Table (0..N Visits, Each With Own Odontogram) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Visit Records Action Bar -->
                        <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Clinical Visit Records &amp; Per-Visit Odontograms"
                                               Style="{StaticResource UniformSectionTitleTextStyle}" />
                                    <TextBlock Text="Every visit maintains its own independent FDI odontogram (MDA / MDC &amp; KKM standard)"
                                               Style="{StaticResource UniformMutedTextStyle}"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open Selected Visit"
                                            Click="OpenSelectedVisitButton_Click"
                                            IsEnabled="{Binding HasSelectedVisit}"
                                            Style="{StaticResource UniformSecondaryButtonStyle}"
                                            Height="32"
                                            Padding="12,0"
                                            Margin="0,0,8,0" />
                                    <Button Content="+ New Visit Record"
                                            Click="CreateNewVisitButton_Click"
                                            Style="{StaticResource UniformPrimaryButtonStyle}"
                                            Height="32"
                                            Padding="12,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 4-Column Paged Visit History Grid (Zero Scrollbars) -->
                        <controls:UniformPagedGrid 
                                                   Grid.Row="1"
                                                   Title="Patient Visit History"
                                                   Subtitle="{Binding VisitsSubtitle}"
                                                   EmptyMessage="No clinical visits yet — newly registered patients start with 0 visit records."
                                                   AutoPageSize="False"
                                                   PageSize="9"
                                                   ItemsSource="{Binding VisitRows}"
                                                   SelectedItem="{Binding SelectedVisitRow, Mode=TwoWay}"
                                                   RowDoubleClicked="VisitsPagedGrid_RowDoubleClicked">
                            <controls:UniformColumnDef Header="Visit &amp; Date" BindingPath="VisitDisplay" WidthRatio="1.25" IsMonospace="True" IsBold="True" />
                            <controls:UniformColumnDef Header="Branch &amp; Clinician" BindingPath="ClinicianDisplay" WidthRatio="1.45" />
                            <controls:UniformColumnDef Header="Diagnosis / Complaint" BindingPath="SummaryDisplay" WidthRatio="1.85" />
                            <controls:UniformColumnDef Header="Visit Odontogram" BindingPath="OdontogramDisplay" WidthRatio="1.2" IsMonospace="True" />
                        </controls:UniformPagedGrid>
                    </Grid>
                </Grid>
            </Grid>
        </controls:ModalDialogShell.DialogContent>

        <controls:ModalDialogShell.FooterLeftContent>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource UniformBodyTextStyle}"
                       Foreground="{StaticResource BrandPrimaryBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </controls:ModalDialogShell.FooterLeftContent>

        <controls:ModalDialogShell.FooterContent>
            <Button Content="{Binding SaveButtonText}"
                    Command="{Binding SaveAllChangesCommand}"
                    Style="{StaticResource UniformPrimaryButtonStyle}" />
        </controls:ModalDialogShell.FooterContent>
    </controls:ModalDialogShell>
</Window>
