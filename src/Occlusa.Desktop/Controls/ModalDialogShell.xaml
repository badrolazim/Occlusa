<UserControl x:Class="Occlusa.Desktop.Controls.ModalDialogShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootShell"
             Background="{StaticResource SurfaceCanvasBrush}"
             ScrollViewer.VerticalScrollBarVisibility="Disabled"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Clinical Teal Accent -->
            <Border Grid.Row="0" Background="{StaticResource BrandPrimaryBrush}" />

            <!-- Standardized Modal Header (Zero Back Navigation) -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dirty State Indicator -->
                        <Border Visibility="{Binding HasUnsavedChanges, ElementName=RootShell, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource WarningBgBrush}"
                                BorderBrush="{StaticResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="● Unsaved Changes"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#B45309"
                                       TextTrimming="None" />
                        </Border>

                        <!-- Optional Header Badge -->
                        <Border Visibility="{Binding HasBadgeText, ElementName=RootShell, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource BrandPrimarySoftBrush}"
                                BorderBrush="#99F6E4"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="10,4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText, ElementName=RootShell}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       TextTrimming="None" />
                        </Border>

                        <Border Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,3"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="ESC"
                                       FontFamily="Consolas"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="None" />
                        </Border>

                        <Button Content="✕"
                                Click="CloseButton_Click"
                                ToolTip="Close modal (Esc)"
                                Style="{StaticResource UniformIconCloseButtonStyle}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title, ElementName=RootShell}"
                                   FontFamily="Segoe UI"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="None" />
                        <TextBlock Text="{Binding Subtitle, ElementName=RootShell}"
                                   Visibility="{Binding HasSubtitle, ElementName=RootShell, Converter={StaticResource BoolToVis}}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="None" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Modal Body (NO ScrollViewer) -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceCanvasBrush}" Padding="18,14">
                <ContentPresenter Content="{Binding DialogContent, ElementName=RootShell}" />
            </Border>

            <!-- Modal Footer -->
            <Border Grid.Row="3"
                    Visibility="{Binding ShowFooterBar, ElementName=RootShell, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Visibility="{Binding ShowDefaultCloseButton, ElementName=RootShell, Converter={StaticResource BoolToVis}}"
                            Content="{Binding CloseButtonText, ElementName=RootShell}"
                            Click="CloseButton_Click"
                            MinWidth="92"
                            Margin="8,0,0,0"
                            Style="{StaticResource UniformSecondaryButtonStyle}" />

                    <ContentPresenter DockPanel.Dock="Right"
                                      Content="{Binding FooterContent, ElementName=RootShell}"
                                      VerticalAlignment="Center" />

                    <ContentPresenter Content="{Binding FooterLeftContent, ElementName=RootShell}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
