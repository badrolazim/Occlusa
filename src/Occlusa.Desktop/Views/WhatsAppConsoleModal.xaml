<Window x:Class="Occlusa.Desktop.Views.WhatsAppConsoleModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="WhatsApp AI Receptionist Console"
        Width="1160"
        Height="800"
        MinWidth="1000"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <controls:ModalDialogShell Title="{Binding ModalTitle}"
                               Subtitle="{Binding ModalSubtitle}"
                               BadgeText="{Binding EmergencyBadgeText}"
                               HasUnsavedChanges="{Binding HasUnsavedChanges, Mode=TwoWay}"
                               SaveCommand="{Binding SendTakeoverReplyCommand}"
                               UnsavedPromptTitle="Unsaved Staff Takeover Draft"
                               UnsavedPromptMessage="You have an unsent staff takeover reply. Send before closing?">

        <controls:ModalDialogShell.DialogContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Paged Chat Transcript (Zero Scrollbars, 3 Msgs per Page) -->
                <Border Grid.Column="0" Style="{StaticResource UniformCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Live WhatsApp Transcript"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Approve AI-Booked (Pending)"
                                    Command="{Binding ApproveAiBookingCommand}"
                                    Visibility="{Binding HasPendingAiBooking, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource UniformWarningButtonStyle}" />
                        </DockPanel>

                        <Border Grid.Row="1"
                                Visibility="{Binding Thread.IsEmergencyEscalated, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{StaticResource DangerBgBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,10">
                            <TextBlock Text="{Binding EmergencyReasonDisplay}"
                                       Style="{StaticResource UniformBodyTextStyle}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding PagedMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource UniformSubtleCardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                <Border DockPanel.Dock="Left"
                                                        Background="{StaticResource BrandTintBrush}"
                                                        BorderBrush="{StaticResource BorderDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Sender}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource BrandHoverBrush}"
                                                               TextTrimming="None" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Timestamp, StringFormat='{}{0:dd MMM HH:mm:ss}'}"
                                                           Style="{StaticResource UniformMutedTextStyle}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       Style="{StaticResource UniformBodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Crisp Paging Footer -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="◀ Older"
                                    Command="{Binding GoOlderPageCommand}"
                                    IsEnabled="{Binding CanGoOlder}"
                                    MinWidth="90"
                                    Style="{StaticResource UniformCompactSecondaryButtonStyle}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding PaginationSummary}"
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="2"
                                    Content="Newer ▶"
                                    Command="{Binding GoNewerPageCommand}"
                                    IsEnabled="{Binding CanGoNewer}"
                                    MinWidth="90"
                                    Style="{StaticResource UniformCompactSecondaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Column: Patient Message Simulator + Staff Emergency Takeover -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Simulator Box -->
                    <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Simulate Patient WhatsApp Message"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Patient Name" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SimPatientName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="WhatsApp Phone" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SimPatientPhone, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformInputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Quick Guardrail Presets:" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Routine Booking"
                                        Command="{Binding ApplyRoutinePresetCommand}"
                                        Style="{StaticResource UniformSecondaryButtonStyle}"
                                        Height="32"
                                        Padding="8,0"
                                        FontSize="12" />
                                <Button Grid.Column="2"
                                        Content="Complex Implant"
                                        Command="{Binding ApplyComplexImplantPresetCommand}"
                                        Style="{StaticResource UniformWarningButtonStyle}"
                                        Height="32"
                                        Padding="8,0"
                                        FontSize="12" />
                                <Button Grid.Column="4"
                                        Content="Emergency Bleed"
                                        Command="{Binding ApplyEmergencyPresetCommand}"
                                        Style="{StaticResource UniformDangerButtonStyle}"
                                        Height="32"
                                        Padding="8,0"
                                        FontSize="12" />
                            </Grid>

                            <TextBlock Text="Inbound Patient Message" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SimMessageText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                     MinHeight="72"
                                     Margin="0,0,0,12" />

                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Right"
                                        Content="Simulate Inbound Message"
                                        Command="{Binding SimulatePatientMessageCommand}"
                                        Style="{StaticResource UniformPrimaryButtonStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Staff Emergency Takeover Box -->
                    <Border Grid.Row="2" Style="{StaticResource UniformCardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Staff Emergency Takeover Reply"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1"
                                       Text="Overrides AI receptionist and posts direct clinician/front-desk guidance to the patient thread."
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <TextBox Grid.Row="2"
                                     Text="{Binding TakeoverReplyText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                     MinHeight="68"
                                     Margin="0,0,0,12" />

                            <DockPanel Grid.Row="3" LastChildFill="False">
                                <Button DockPanel.Dock="Right"
                                        Content="Send Staff Takeover Reply"
                                        Command="{Binding SendTakeoverReplyCommand}"
                                        Style="{StaticResource UniformDangerButtonStyle}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </controls:ModalDialogShell.DialogContent>

        <controls:ModalDialogShell.FooterLeftContent>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource UniformBodyTextStyle}"
                       Foreground="{StaticResource BrandHoverBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </controls:ModalDialogShell.FooterLeftContent>
    </controls:ModalDialogShell>
</Window>
