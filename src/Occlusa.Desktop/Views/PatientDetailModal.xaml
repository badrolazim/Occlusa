<Window x:Class="Occlusa.Desktop.Views.PatientDetailModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="Patient Clinical Record"
        Width="1180"
        Height="840"
        MinWidth="1040"
        MinHeight="740"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceCanvasBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <controls:ModalDialogShell x:Name="DialogShell"
                               Title="{Binding ModalTitle}"
                               Subtitle="{Binding ModalSubtitle}"
                               BadgeText="{Binding MyKadBadgeLabel}"
                               HasUnsavedChanges="{Binding HasUnsavedChanges, Mode=TwoWay}"
                               SaveCommand="{Binding SaveAllChangesCommand}"
                               UnsavedPromptTitle="Unsaved Clinical Changes"
                               UnsavedPromptMessage="You have unsaved patient alerts or SOAP note edits. Save changes before closing?">

        <controls:ModalDialogShell.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Pinned Clinical Safety Banner (Always Visible at Top) -->
                <controls:MedicalAlertsBanner Grid.Row="0"
                                              Margin="0,0,0,12"
                                              PatientName="{Binding Patient.FullName}"
                                              IcNumber="{Binding Patient.IcNumber}"
                                              IsMyKadVerified="{Binding Patient.IsMyKadVerified}"
                                              Allergies="{Binding Allergies}"
                                              OnAnticoagulants="{Binding OnAnticoagulants}"
                                              HasDiabetes="{Binding HasDiabetes}"
                                              IsPregnant="{Binding IsPregnant}"
                                              AlertNotes="{Binding AlertNotes}" />

                <!-- Two-Column Clinical Workspace (Zero Scrollbars) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Demographics, Medical Alerts, Consent, Paged SOAP History -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Demographics & Medical Alerts Card -->
                        <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Demographics &amp; Safety Flags"
                                               Style="{StaticResource UniformSectionTitleTextStyle}"
                                               VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right"
                                            Content="Sign PDPA Consent"
                                            Command="{Binding SignConsentCommand}"
                                            Style="{StaticResource UniformCompactSecondaryButtonStyle}" />
                                </DockPanel>

                                <TextBlock Text="{Binding ConsentStatusText}"
                                           Style="{StaticResource UniformMutedTextStyle}"
                                           Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="136" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Phone" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource UniformInputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Address" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource UniformInputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Drug / Latex Allergies" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Allergies, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource UniformInputTextBoxStyle}"
                                         Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Content="Anticoagulants"
                                              IsChecked="{Binding OnAnticoagulants}"
                                              Style="{StaticResource UniformCheckBoxStyle}" />
                                    <CheckBox Grid.Column="1"
                                              Content="Diabetes"
                                              IsChecked="{Binding HasDiabetes}"
                                              Style="{StaticResource UniformCheckBoxStyle}" />
                                    <CheckBox Grid.Column="2"
                                              Content="Pregnant"
                                              IsChecked="{Binding IsPregnant}"
                                              Style="{StaticResource UniformCheckBoxStyle}" />
                                </Grid>

                                <TextBlock Text="Clinical Safety Notes" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AlertNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource UniformInputTextBoxStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Paged SOAP Notes History (1 Full Note per Page, Zero Scrollbars) -->
                        <Border Grid.Row="2" Style="{StaticResource UniformCardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="SOAP Note History"
                                               Style="{StaticResource UniformSectionTitleTextStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SoapPaginationSummary}"
                                               Style="{StaticResource UniformMutedTextStyle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Style="{StaticResource UniformSubtleCardBorderStyle}"
                                        Visibility="{Binding HasSoapNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding CurrentSoapNote.DoctorName}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource UniformBodyTextStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding CurrentSoapNote.VisitDate, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"
                                                       Style="{StaticResource UniformMutedTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding CurrentSoapNote.Subjective, StringFormat='S: {0}'}"
                                                   Style="{StaticResource UniformBodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2" />
                                        <TextBlock Text="{Binding CurrentSoapNote.Objective, StringFormat='O: {0}'}"
                                                   Style="{StaticResource UniformBodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2" />
                                        <TextBlock Text="{Binding CurrentSoapNote.Assessment, StringFormat='A: {0}'}"
                                                   Style="{StaticResource UniformBodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2" />
                                        <TextBlock Text="{Binding CurrentSoapNote.Plan, StringFormat='P: {0}'}"
                                                   Style="{StaticResource UniformBodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2" />
                                        <TextBlock Style="{StaticResource UniformMutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap">
                                            <Run Text="LA: " />
                                            <Run Text="{Binding CurrentSoapNote.AnesthesiaUsed, Mode=OneWay}" />
                                            <Run Text=" · Shade: " />
                                            <Run Text="{Binding CurrentSoapNote.ToothShade, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1"
                                        Style="{StaticResource UniformSubtleCardBorderStyle}"
                                        Visibility="{Binding HasSoapNotes, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="No prior SOAP notes recorded for this patient."
                                               Style="{StaticResource UniformMutedTextStyle}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
                                    <Button DockPanel.Dock="Left"
                                            Content="◀ Prev"
                                            Command="{Binding PrevSoapPageCommand}"
                                            IsEnabled="{Binding CanGoPrevSoap}"
                                            MinWidth="86"
                                            Style="{StaticResource UniformCompactSecondaryButtonStyle}" />
                                    <Button DockPanel.Dock="Right"
                                            Content="Next ▶"
                                            Command="{Binding NextSoapPageCommand}"
                                            IsEnabled="{Binding CanGoNextSoap}"
                                            MinWidth="86"
                                            Style="{StaticResource UniformCompactSecondaryButtonStyle}" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right Column: New SOAP Note Editor + 1-Click Smart SOAP Macros -->
                    <Border Grid.Column="2" Style="{StaticResource UniformCardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="New Clinical SOAP Note"
                                           Style="{StaticResource UniformSectionTitleTextStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding SoapMacros}"
                                              SelectedItem="{Binding SelectedMacro}"
                                              DisplayMemberPath="Title"
                                              Width="240"
                                              Style="{StaticResource UniformComboBoxStyle}"
                                              Margin="0,0,8,0" />
                                    <Button Content="Apply Macro"
                                            Command="{Binding ApplySelectedMacroCommand}"
                                            Style="{StaticResource UniformSecondaryButtonStyle}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Quick 1-Click Clinical Macro Chips -->
                            <Border Grid.Row="1" Style="{StaticResource UniformSubtleCardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Anesthesia:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="2% Mepivacaine" Command="{Binding ApplyAnesthesiaMacroCommand}" CommandParameter="2% Mepivacaine 1:100k" Style="{StaticResource UniformChipButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="4% Articaine" Command="{Binding ApplyAnesthesiaMacroCommand}" CommandParameter="4% Articaine 1:100k" Style="{StaticResource UniformChipButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="Topical Gel" Command="{Binding ApplyAnesthesiaMacroCommand}" CommandParameter="20% Benzocaine Topical" Style="{StaticResource UniformChipButtonStyle}" />

                                        <Border Width="1" Height="16" Background="{StaticResource BorderHairlineBrush}" Margin="10,0" VerticalAlignment="Center" />

                                        <TextBlock Text="Shade:" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <Button Content="A1" Command="{Binding ApplyShadeMacroCommand}" CommandParameter="A1" Style="{StaticResource UniformChipButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="A2" Command="{Binding ApplyShadeMacroCommand}" CommandParameter="A2" Style="{StaticResource UniformChipButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="A3" Command="{Binding ApplyShadeMacroCommand}" CommandParameter="A3" Style="{StaticResource UniformChipButtonStyle}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Post-Op:"
                                               Style="{StaticResource UniformLabelTextStyle}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Routine Hygiene" Command="{Binding ApplyPostOpMacroCommand}" CommandParameter="Warm saline rinse, soft brush tonight." Style="{StaticResource UniformChipButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="Filling Care" Command="{Binding ApplyPostOpMacroCommand}" CommandParameter="Avoid hard biting for 2h if numb; return if high bite." Style="{StaticResource UniformChipButtonStyle}" Margin="0,0,6,0" />
                                        <Button Content="Extraction Care" Command="{Binding ApplyPostOpMacroCommand}" CommandParameter="Bite gauze 30 min, no straw/spitting 24h, soft diet." Style="{StaticResource UniformChipButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SOAP Form Fields -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="S — Subjective (Chief Complaint)" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding NewSubjective, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                             MinHeight="46" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="O — Objective (Clinical Findings)" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding NewObjective, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                             MinHeight="46" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="A — Assessment / Diagnosis" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding NewAssessment, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                             MinHeight="46" />
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="P — Plan &amp; Treatment Performed" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,3" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding NewPlan, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                             MinHeight="46" />
                                </Grid>

                                <Grid Grid.Row="4" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Anesthesia" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewAnesthesia, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource UniformInputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Shade" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewToothShade, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource UniformInputTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Post-Op Instructions" Style="{StaticResource UniformLabelTextStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewPostOp, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource UniformInputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </controls:ModalDialogShell.DialogContent>

        <controls:ModalDialogShell.FooterLeftContent>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource UniformBodyTextStyle}"
                       Foreground="{StaticResource BrandPrimaryBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </controls:ModalDialogShell.FooterLeftContent>

        <controls:ModalDialogShell.FooterContent>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open 32-Tooth Odontogram"
                        Click="OpenOdontogramButton_Click"
                        Style="{StaticResource UniformSecondaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="Save Chart &amp; SOAP Note"
                        Command="{Binding SaveAllChangesCommand}"
                        Style="{StaticResource UniformPrimaryButtonStyle}" />
            </StackPanel>
        </controls:ModalDialogShell.FooterContent>
    </controls:ModalDialogShell>
</Window>
