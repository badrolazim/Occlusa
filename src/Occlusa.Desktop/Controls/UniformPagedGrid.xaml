<UserControl x:Class="Occlusa.Desktop.Controls.UniformPagedGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootGridControl"
             ScrollViewer.VerticalScrollBarVisibility="Disabled"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="UniformColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UniformDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0FDFA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCFBF1" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UniformDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- Optional Header Bar -->
            <Border Grid.Row="0"
                    Visibility="{Binding HasHeaderText, ElementName=RootGridControl, Converter={StaticResource BoolToVis}}"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="14,9">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Title, ElementName=RootGridControl}"
                               FontFamily="Segoe UI"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"
                               TextTrimming="None" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Subtitle, ElementName=RootGridControl}"
                               FontFamily="Segoe UI"
                               FontSize="11.5"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               TextTrimming="None" />
                </DockPanel>
            </Border>

            <!-- Main 3-4 Column Paged DataGrid (Zero Scrollbars, Zero TextTrimming) -->
            <Grid Grid.Row="1">
                <DataGrid x:Name="InternalDataGrid"
                          ItemsSource="{Binding PagedItems, ElementName=RootGridControl}"
                          SelectedItem="{Binding SelectedItem, ElementName=RootGridControl, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          Background="#FFFFFF"
                          BorderThickness="0"
                          RowHeight="36"
                          ColumnHeaderStyle="{StaticResource UniformColumnHeaderStyle}"
                          RowStyle="{StaticResource UniformDataGridRowStyle}"
                          CellStyle="{StaticResource UniformDataGridCellStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False"
                          MouseDoubleClick="InternalDataGrid_MouseDoubleClick" />

                <!-- Empty State Overlay -->
                <Border Background="#FFFFFF"
                        Visibility="{Binding IsEmpty, ElementName=RootGridControl, Converter={StaticResource BoolToVis}}"
                        Margin="0,36,0,0"
                        Padding="20">
                    <TextBlock Text="{Binding EmptyMessage, ElementName=RootGridControl}"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                </Border>
            </Grid>

            <!-- Clean Pagination Footer -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="◀ Prev"
                            Click="PrevPageButton_Click"
                            IsEnabled="{Binding CanGoPrev, ElementName=RootGridControl}"
                            MinWidth="86"
                            Style="{StaticResource UniformCompactSecondaryButtonStyle}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding PaginationSummary, ElementName=RootGridControl}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="None" />

                    <Button Grid.Column="2"
                            Content="Next ▶"
                            Click="NextPageButton_Click"
                            IsEnabled="{Binding CanGoNext, ElementName=RootGridControl}"
                            MinWidth="86"
                            Style="{StaticResource UniformCompactSecondaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
