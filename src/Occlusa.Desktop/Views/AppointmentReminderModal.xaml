<Window x:Class="Occlusa.Desktop.Views.AppointmentReminderModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Occlusa.Desktop.Controls"
        Title="Appointment Reminder"
        Width="660"
        Height="510"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceCanvasBrush}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <controls:ModalDialogShell x:Name="DialogShell"
                               Title="{Binding ModalTitle}"
                               Subtitle="{Binding ModalSubtitle}"
                               BadgeText="{Binding CurrentReminderBadge}"
                               CloseButtonText="Cancel">

        <controls:ModalDialogShell.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Patient & Current Reminder Status Summary -->
                <Border Grid.Row="0" Style="{StaticResource UniformCardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PATIENT CONTACT"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       FontSize="10.5"
                                       Margin="0,0,0,3" />
                            <TextBlock Text="{Binding PatientName}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding PhoneDisplay}"
                                       Style="{StaticResource UniformMonoTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="None" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CURRENT REMINDER STATUS"
                                       Style="{StaticResource UniformLabelTextStyle}"
                                       FontSize="10.5"
                                       Margin="0,0,0,3" />
                            <TextBlock Text="{Binding CurrentReminderBadge}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrandPrimaryBrush}"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding CurrentReminderSummary}"
                                       Style="{StaticResource UniformMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       TextTrimming="None" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bilingual WhatsApp Reminder Preview -->
                <Border Grid.Row="1" Style="{StaticResource UniformCardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="WhatsApp Reminder Message (EN / BM)"
                                       Style="{StaticResource UniformSectionTitleTextStyle}"
                                       FontSize="13.5"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Reset Template"
                                    Command="{Binding ResetDefaultMessageCommand}"
                                    Style="{StaticResource UniformGhostButtonStyle}"
                                    Height="26"
                                    FontSize="11.5" />
                        </DockPanel>

                        <TextBox Grid.Row="1"
                                 Text="{Binding WhatsAppMessageText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource UniformMultiLineTextBoxStyle}"
                                 MinHeight="88"
                                 VerticalContentAlignment="Top" />

                        <TextBlock Grid.Row="2"
                                   Text="Tip: When the patient replies 'YES', 'YA', or 'Confirm' on WhatsApp, Live Queue automatically updates to Confirmed."
                                   Style="{StaticResource UniformMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </Grid>
                </Border>

                <!-- Quick Manual Status Recording (Phone Call / SMS / Confirmed / No Reply) -->
                <Border Grid.Row="2" Style="{StaticResource UniformSubtleCardBorderStyle}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Or Record Manual Outreach (Phone Call / Clinic Phone)"
                                   Style="{StaticResource UniformLabelTextStyle}"
                                   Margin="0,0,0,8" />
                        <UniformGrid Columns="4" Rows="1">
                            <Button Content="Mark Reminded (Call)"
                                    Command="{Binding MarkRemindedCallCommand}"
                                    IsEnabled="{Binding CanAct}"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    FontSize="11.5"
                                    Margin="0,0,6,0" />
                            <Button Content="Mark Reminded (SMS)"
                                    Command="{Binding MarkRemindedSmsCommand}"
                                    IsEnabled="{Binding CanAct}"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    FontSize="11.5"
                                    Margin="0,0,6,0" />
                            <Button Content="✓ Mark Confirmed"
                                    Command="{Binding MarkConfirmedCommand}"
                                    IsEnabled="{Binding CanAct}"
                                    Style="{StaticResource UniformSecondaryButtonStyle}"
                                    Height="32"
                                    FontSize="11.5"
                                    Margin="0,0,6,0" />
                            <Button Content="No Reply"
                                    Command="{Binding MarkNoReplyCommand}"
                                    IsEnabled="{Binding CanAct}"
                                    Style="{StaticResource UniformGhostButtonStyle}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Height="32"
                                    FontSize="11.5" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </controls:ModalDialogShell.DialogContent>

        <controls:ModalDialogShell.FooterLeftContent>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource UniformBodyTextStyle}">
                        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </controls:ModalDialogShell.FooterLeftContent>

        <controls:ModalDialogShell.FooterContent>
            <Button Content="Send WhatsApp Reminder"
                    Command="{Binding SendWhatsAppReminderCommand}"
                    IsEnabled="{Binding CanSendWhatsApp}"
                    Style="{StaticResource UniformPrimaryButtonStyle}" />
        </controls:ModalDialogShell.FooterContent>
    </controls:ModalDialogShell>
</Window>
